# Read by `docker compose` (docker-compose.yml) from the repo root. Copy to `.env`.
# The defaults below are for local development only; every server MUST set strong random values here
# and mirror them in apps/api/.env (DATABASE_URL, REDIS_URL). POSTGRES_PASSWORD only applies when the data
# volume is first created — on an existing volume rotate it with ALTER USER and then update this file.
POSTGRES_PASSWORD=petlife
REDIS_PASSWORD=petlife
MINIO_ROOT_USER=petlife
MINIO_ROOT_PASSWORD=petlife123
