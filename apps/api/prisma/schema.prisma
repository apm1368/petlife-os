/// Shared "setup completeness" vocabulary for the three single-row-per-pet
/// health/care summary models (HealthProfile, NutritionProfile, CareProfile).
/// Deliberately not per-field boolean flags — see the Known Negative /
/// Unknown / Incomplete product rule documented on HealthProfile below.
enum SetupStatus {
  NOT_STARTED
  PARTIAL
  COMPLETE
}

/// Provenance for every health/care record. OWNER is the only source fully
/// implemented in this phase — PROVIDER/IMPORTED_DOCUMENT exist as
/// future-compatible states with no editable integration yet, and SYSTEM is
/// reserved for derived/setup rows. OWNER-entered data is never marked as
/// verified provider data.
///
/// Handoff 17 adds HOUSEHOLD_MEMBER (an owner-adjacent household member, as
/// distinct from the primary OWNER) and CLINIC (a provider organization
/// acting institutionally, e.g. an imported clinic record not attributable
/// to one specific ProviderUser) — additive values only; IMPORTED_DOCUMENT
/// and SYSTEM already cover the "system-imported"/"derived" cases, so no
/// separate SYSTEM_IMPORT value was added (avoids duplicating provenance
/// vocabulary that already exists).
enum SourceType {
  OWNER
  HOUSEHOLD_MEMBER
  PROVIDER
  CLINIC
  IMPORTED_DOCUMENT
  SYSTEM
}

/// Per-domain state for a list-backed health area (allergies/conditions/
/// medications) when that list has zero rows — distinguishes an explicit
/// "no known X" (NONE_KNOWN) from "owner doesn't know" (UNKNOWN). The absence
/// of this field being set at all (NULL, on HealthProfile) means Incomplete —
/// the question was never answered. Once the list has rows, the list is the
/// source of truth and this field is no longer consulted for that domain.
enum HealthAreaKnowledgeState {
  NONE_KNOWN
  UNKNOWN
}

/// Per-allergy-row confidence — distinct from HealthAreaKnowledgeState above,
/// which describes the allergies list as a whole. KNOWN = confirmed; UNKNOWN
/// = suspected/unconfirmed but still worth recording (e.g. an owner notices a
/// reaction but hasn't identified the allergen with certainty).
enum AllergyKnowledgeState {
  KNOWN
  UNKNOWN
}

enum AllergyStatus {
  ACTIVE
  RESOLVED
}

/// Never inferred — only ever set by an explicit owner/provider choice.
enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
  HISTORICAL
}

enum MedicationStatus {
  ACTIVE
  SCHEDULED
  COMPLETED
  HISTORICAL
}

/// UNKNOWN and INCOMPLETE are deliberately distinct and neither is ever
/// derived as OVERDUE: UNKNOWN means the owner said they don't know the
/// vaccination status; INCOMPLETE means the question hasn't been addressed
/// (no VaccinationSummary row exists) or vaccination has begun but isn't
/// resolved to a concrete status yet. OVERDUE is only ever set from an
/// explicit nextDueDate that has passed — never inferred from missing data.
enum VaccinationStatus {
  UP_TO_DATE
  DUE_SOON
  OVERDUE
  UNKNOWN
  INCOMPLETE
}

enum DietType {
  DRY
  WET
  RAW
  MIXED
  PRESCRIPTION
  OTHER
  UNKNOWN
}

/// The full severity vocabulary the architecture must support long-term.
/// This handoff only ever assigns NORMAL / INFORMATIONAL / ATTENTION — no
/// urgent/emergency detection logic exists yet, but HealthSummaryService's
/// output type is already shaped to carry the higher severities without a
/// breaking change when that logic is built.
enum HealthSeverity {
  NORMAL
  INFORMATIONAL
  ATTENTION
  HIGHER_CONCERN
  URGENT
  EMERGENCY
}

// ---------------------------------------------------------------------------
// Provider / booking (Handoff 03)
// ---------------------------------------------------------------------------

/// A coarse "kind of business" classification — deliberately independent from
/// ServiceCategory (see below), which is the authoritative taxonomy used for
/// discovery/compatibility/filtering. A provider's `type` is closer to
/// self-described business identity (e.g. what shows on their profile
/// header); a MULTI_SERVICE_PROVIDER can offer services across several
/// categories (e.g. a clinic that also grooms), and each ProviderService
/// carries its own `category` rather than inferring one from the org's type.
enum ProviderType {
  VET_CLINIC
  VET_HOSPITAL
  VETERINARIAN
  GROOMER
  TRAINER
  WALKER
  SITTER
  BOARDING
  PET_TAXI
  MULTI_SERVICE_PROVIDER
}

/// The canonical service taxonomy (Handoff 04) — discovery, compatibility,
/// and Home/Care Calendar integration all key off this field, never off a
/// display string or ProviderServiceType. VET is retained as a category so
/// Handoff 03's vet booking flow is just one category among several here,
/// not a special case.
enum ServiceCategory {
  VET
  GROOMING
  TRAINING
  WALKING
  SITTING
  BOARDING
  PET_TAXI
}

/// Where a booked service actually happens. AT_PROVIDER needs no address
/// (clinic/grooming salon/boarding facility); AT_CUSTOMER and MOBILE require
/// a CustomerAddress (sitting/training/walking, or a provider that travels to
/// the customer); TRANSPORT (pet taxi) requires both a pickup and a dropoff
/// CustomerAddress. See BookingsService for the exact ADDRESS_REQUIRED rule.
enum LocationMode {
  AT_PROVIDER
  AT_CUSTOMER
  MOBILE
  TRANSPORT
}

/// Only VERIFIED providers appear in default consumer discovery
/// (ProvidersService.searchVets) — every other status is either not yet
/// reviewed or no longer eligible to be shown.
enum ProviderVerificationStatus {
  NOT_STARTED
  SUBMITTED
  NEEDS_INFORMATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

/// A provider-organization membership role — deliberately NOT a pet-data
/// permission source. PetAccessGrant remains the only source of truth for
/// what a provider user can see about a pet; this only controls what they
/// can do inside their own organization's data (out of scope this phase).
enum ProviderUserRole {
  OWNER
  VET
  STAFF
}

/// Kept extensible on purpose — more service types will be added as the
/// product grows, without ever needing a "type of type" indirection.
enum ProviderServiceType {
  GENERAL_VET_VISIT
  VACCINATION
  FOLLOW_UP
  CONSULTATION
  GROOMING_SESSION
  TRAINING_SESSION
  DOG_WALK
  PET_SITTING
  BOARDING_STAY
  PET_TAXI_RIDE
}

enum AvailabilityExceptionType {
  BLOCKED
  AVAILABLE_OVERRIDE
}

/// HOLD exists in the vocabulary for completeness but is never the status of
/// a persisted Booking row — a hold lives only in Redis (see
/// BookingHoldService) until it is either confirmed (the Booking row is
/// created directly at CONFIRMED, there being no real payment-authorization
/// gate in this phase) or it expires and is simply discarded.
/// CHECKED_IN/IN_PROGRESS/COMPLETED/NO_SHOW/CANCELLED_BY_PROVIDER are part of
/// the vocabulary this phase's architecture must support but no endpoint
/// transitions a booking to them yet — see README Known limitations.
enum BookingStatus {
  HOLD
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_USER
  CANCELLED_BY_PROVIDER
  NO_SHOW
}

/// Deliberately a separate state machine from BookingStatus — a booking can
/// be CONFIRMED while payment is still PENDING, or CANCELLED while a refund
/// is still REFUND_PENDING. No real payment gateway exists this phase (see
/// README Known limitations), so every booking's paymentStatus is currently
/// always NOT_REQUIRED; the full vocabulary exists so wiring a real gateway
/// later needs no schema change.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

/// What a booking-confirmation-time TEMPORARY PetAccessGrant actually
/// exposes. Never "full health record" by default — see
/// BookingPetAccessService and the README section on data minimization.
/// Renamed from HealthAccessScopePreset (Handoff 03) now that booking access
/// spans every service category, not just vet visits — MINIMAL_VET_CONTEXT/
/// HEALTH_BASICS/SELECTED_HEALTH_DATA are the original vet-only presets,
/// preserved unchanged for existing vet bookings; the *_BASIC presets are the
/// new per-category Care Profile-only presets (Handoff 04 section 7).
enum PetAccessScopePreset {
  MINIMAL_VET_CONTEXT
  HEALTH_BASICS
  SELECTED_HEALTH_DATA
  GROOMING_BASIC
  TRAINING_BASIC
  WALKING_BASIC
  SITTING_BASIC
  BOARDING_BASIC
  TAXI_BASIC
}

/// Mirrors ServiceCategory (Handoff 04) so a Care Calendar row's type is
/// always derivable from the booking category that created it, rather than
/// being its own independent vocabulary. VET_APPOINTMENT is Handoff 03's
/// original value, kept unchanged for existing vet bookings.
enum CareCalendarEventType {
  VET_APPOINTMENT
  GROOMING_APPOINTMENT
  TRAINING_SESSION
  WALK
  SITTING
  BOARDING
  PET_TAXI
}

enum CareCalendarEventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// Recurrence is intentionally minimal this phase (Handoff 04 section 25) —
/// only a flat "repeat weekly N times" shape, generated up front at series
/// creation. No custom interval/day-of-week picker.
enum BookingSeriesFrequency {
  ONE_TIME
  WEEKLY
}

/// PAUSED/COMPLETED are part of the vocabulary this phase's architecture must
/// support (spec section 27) but nothing transitions a series to them yet —
/// only ACTIVE (the default) and CANCELLED are reachable. See README Known
/// limitations.
enum BookingSeriesStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

// ---------------------------------------------------------------------------
// Commerce Core (Handoff 06) — Product/Variant/Offer/Cart/Checkout/Order/Payment
// ---------------------------------------------------------------------------

/// Deliberately its own vocabulary, not a reuse of ProviderVerificationStatus
/// — a SellerOrganization is a different kind of party (goods, not services)
/// even though the review states happen to line up 1:1 today.
enum SellerVerificationStatus {
  NOT_STARTED
  SUBMITTED
  NEEDS_INFORMATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

/// Separate axis from verification — a VERIFIED seller can still be
/// deactivated/suspended without losing its review history. PENDING/
/// RESTRICTED/CLOSED added in Handoff 09 (spec section 3) — purely additive
/// enum values, nothing pre-existing read/wrote them, so no data migration
/// is needed for the widened vocabulary.
enum SellerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  RESTRICTED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum SellerOfferStatus {
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Seller OS + Marketplace Channel Integrations (Handoff 09)
// ---------------------------------------------------------------------------

/// Mirrors ProviderUserRole's precedent of a role vocabulary scoped to one
/// organization type (spec section 4). OWNER is the only role that can
/// manage other memberships; SellerAccessService is the single place that
/// interprets what each role may do (never re-derived ad hoc in a
/// controller).
enum SellerMembershipRole {
  OWNER
  ADMIN
  OPERATIONS
  CATALOG_MANAGER
  ORDER_MANAGER
  FINANCE
  SUPPORT
  VIEWER
}

/// PENDING covers a dev/local invite that has not been "accepted" yet (spec
/// section 48: "acceptable to create a dev/local invite flow" — no
/// email/SMS delivery exists, see README). DEACTIVATED is a soft-remove:
/// the row (and its audit trail) is preserved rather than deleted.
enum SellerMembershipStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

/// Every reason InventoryItem.onHand/reserved can ever change (spec section
/// 8) — SellerInventoryService and MarketplaceOrderIngestionService are the
/// only writers, and every write is paired with one of these rows.
enum InventoryMovementType {
  MANUAL_ADJUSTMENT
  ORDER_RESERVATION
  ORDER_RELEASE
  ORDER_COMMIT
  MARKETPLACE_ORDER
  MARKETPLACE_CANCELLATION
  RETURN
  RECONCILIATION
  IMPORT
  SYSTEM_CORRECTION
}

/// DEV exists purely for tests/local development (spec section 21), the
/// same role DEV plays in ShippingProvider/PaymentProvider — hard-gated out
/// of production the same way (see marketplace-channel-registry.service.ts).
enum MarketplaceProvider {
  DEV
  TOROB
  DIGIKALA
}

enum MarketplaceChannelAccountStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  DEGRADED
  ERROR
  SUSPENDED
}

/// Business state — "is this listing meant to be for sale" — kept separate
/// from MarketplaceListingSyncStatus ("did the last sync succeed"), mirroring
/// Fulfillment-status-vs-Shipment-status from Handoff 08 (spec section 16).
enum MarketplaceListingStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  REJECTED
  ERROR
  ARCHIVED
}

enum MarketplaceListingSyncStatus {
  NEVER_SYNCED
  QUEUED
  SYNCING
  SYNCED
  DEGRADED
  FAILED
}

/// Canonical, provider-independent order lifecycle (spec section 29) —
/// marketplace-order-status-normalizer.ts is the only place a raw provider
/// status is mapped to one of these; an unrecognized raw status is recorded
/// for reconciliation rather than guessed into one of these values.
enum MarketplaceOrderStatus {
  RECEIVED
  CONFIRMED
  PROCESSING
  READY_TO_FULFILL
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  FAILED
  /// An unrecognized raw provider status (spec section 29) — never guessed
  /// into one of the above, recorded for reconciliation instead, the same
  /// "UNKNOWN must never imply success" rule as ShipmentStatus.UNKNOWN
  /// (Handoff 08).
  UNKNOWN
}

/// Who actually performs last-mile delivery for a given Fulfillment (spec
/// section 27) — PET LIFE OS must never assume it always owns this. Added to
/// the existing Fulfillment model (Handoff 08) with a default of PETLIFE,
/// which is exactly what every Handoff 08 Fulfillment already implicitly was.
enum DeliveryResponsibility {
  PETLIFE
  MARKETPLACE
  SELLER
  EXTERNAL
}

/// Who actually collected payment for an Order (spec section 28) — never
/// fabricate a PaymentIntent for a marketplace-collected sale; this field is
/// the honest alternative. UNKNOWN is a real, queryable state, not an error.
enum PaymentSourceType {
  PETLIFE_PAYMENT
  MARKETPLACE_COLLECTED
  CASH_ON_DELIVERY
  UNKNOWN
}

enum MarketplaceSyncOperation {
  LISTING_PUBLISH
  LISTING_UPDATE
  LISTING_DEACTIVATE
  PRICE_SYNC
  INVENTORY_SYNC
  ORDER_FETCH
  ORDER_ACK
  ORDER_CANCEL
  RECONCILE
}

enum MarketplaceSyncAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

/// PARTIALLY_CONFIRMED exists for the "N orders, not all succeed" case (spec
/// section 32) — this phase's happy-path payment flow never produces it
/// (DevPaymentGateway's SUCCESS mode confirms every seller's Order in the
/// same transaction), but the data model supports it without a migration
/// once a real multi-capture gateway exists.
enum CheckoutStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAYMENT_PENDING
  CONFIRMED
  PARTIALLY_CONFIRMED
  FAILED
  EXPIRED
  /// Handoff 07 (spec section 21) — payment/financing was approved by the
  /// provider but Order confirmation itself failed (e.g. inventory became
  /// unavailable between authorization and confirmation). Deliberately
  /// distinct from FAILED (money moved) and CONFIRMED (orders exist) — see
  /// CheckoutService.finalizeSuccessfulPayment and README "Paid but order
  /// cannot confirm".
  PAYMENT_SUCCEEDED_ORDER_ISSUE
}

/// Handoff 07 (spec section 11) — chosen once, before a PaymentIntent or
/// FinancingIntent exists for the checkout. Deliberately just these two
/// canonical types; which specific provider/plan is chosen within
/// INSTALLMENTS lives on FinancingIntent, never here.
enum PaymentMethodType {
  ONLINE_PAYMENT
  INSTALLMENTS
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

/// PREPARING/READY_FOR_FULFILLMENT/FULFILLED/PARTIALLY_REFUNDED/REFUNDED are
/// part of the vocabulary this phase's architecture must support (spec
/// section 30) but nothing transitions an Order to them yet — only
/// PENDING/CONFIRMED/CANCELLED are reachable. See README Known limitations.
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_FULFILLMENT
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// A placeholder axis only — no delivery integration this phase (spec
/// section 47); both values currently produce the same dev-calculated
/// deliveryAmount.
enum DeliveryMethod {
  STANDARD
  EXPRESS
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

/// Handoff 06 shipped only DEV_SIMULATED to prove the adapter shape; Handoff
/// 07 (spec section 3) adds the canonical registry's other members —
/// STANDARD_GATEWAY (a provider-neutral, real-shaped adapter, sandbox-only
/// since no merchant credentials exist for this project — see README) and
/// the two BNPL providers. Each is still just an enum value plus an adapter
/// class; CheckoutService/FinancingService never branch on provider identity
/// themselves (see PROVIDER_CAPABILITIES in payment-provider-registry.ts).
enum PaymentProvider {
  DEV_SIMULATED
  STANDARD_GATEWAY
  SNAPP_PAY
  DIGI_PAY
}

enum PaymentAttemptStatus {
  STARTED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TransactionType {
  CHARGE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Handoff 07 (spec section 4) — a separate state machine from
/// PaymentIntentStatus on purpose (spec section 6: "do not collapse into one
/// payment status"). A FinancingIntent never reaches CAPTURED/AUTHORIZED —
/// those are PaymentIntent-only vocabulary.
enum FinancingIntentStatus {
  CREATED
  ELIGIBILITY_PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  PLAN_SELECTED
  AUTHORIZATION_PENDING
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Handoff 07 (spec section 23) — deliberately its own enum, never reusing
/// PaymentAttemptStatus/TransactionStatus, since a refund's lifecycle (an
/// explicit REQUESTED step before any provider call) differs from a charge
/// attempt's.
enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Handoff 07 (spec section 17) — tracks a raw provider webhook delivery
/// through its idempotent processing, independent of whatever
/// PaymentIntent/FinancingIntent status it ultimately caused.
enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

/// Handoff 07 (spec section 31) — the initial conceptual chart of accounts.
/// SELLER_PAYABLE and PLATFORM_REVENUE are seeded as placeholder rows only
/// (spec: "do not implement seller settlement yet" / "do not invent provider
/// fees") — nothing posts to them this phase; see README "Ledger accounts".
enum LedgerAccountCode {
  CASH_GATEWAY_RECEIVABLE
  CUSTOMER_PAYMENT_CLEARING
  SELLER_PAYABLE
  REFUND_PAYABLE
  PLATFORM_REVENUE
  /// Handoff 14 — "money an external marketplace channel owes us" (the
  /// mirror-image of CASH_GATEWAY_RECEIVABLE for a sale PET LIFE OS itself
  /// never collected cash for). Never debited by a real cash receipt this
  /// phase — no official Torob/Digikala settlement API exists to confirm
  /// one (see README "External provider status").
  MARKETPLACE_RECEIVABLE
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

// ---------------------------------------------------------------------------
// Marketplace & Seller Financial Settlement (Handoff 14)
// ---------------------------------------------------------------------------

/// Which sales channel an Order came through (spec: "financial processing
/// must distinguish order source"). Deliberately not a stored Order column —
/// see the Order model's own doc comment on `financialBreakdown` for why
/// this is safely derived (checkoutId non-null => PET_LIFE; otherwise the
/// linked MarketplaceOrder.provider) rather than a second, potentially
/// drifting source of truth. Persisted here only where it is a genuine
/// first-class dimension: CommissionRule.channel and OrderFinancialBreakdown.origin.
enum OrderOrigin {
  PET_LIFE
  DEV_MARKETPLACE
  TOROB
  DIGIKALA
}

/// Data-confidence tag for a marketplace-reported fee (spec: "never
/// silently assume zero if unknown"). KNOWN = the provider's own
/// statement/API told us; ESTIMATED = we computed a best guess from a
/// published rate card; UNKNOWN = no data at all.
enum FinancialConfidence {
  KNOWN
  ESTIMATED
  UNKNOWN
}

enum SellerFinancialAccountStatus {
  ACTIVE
  SUSPENDED
}

enum SellerSettlementScheduleType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  MANUAL
}

/// Deliberately fewer states than the spec's own suggested superset
/// (DRAFT/READY/PROCESSING/PARTIALLY_PAID are not modeled) — see README
/// "Settlement lifecycle" for why: MANUAL-only payout (no async provider)
/// makes PROCESSING/PARTIALLY_PAID unreachable this phase, and
/// calculate() always produces a fully-computed settlement in one step, so
/// DRAFT/READY/CALCULATED would be indistinguishable states.
enum SellerSettlementStatus {
  CALCULATED
  APPROVED
  PAID
  FAILED
  RECONCILIATION_REQUIRED
  CANCELLED
}

enum SellerAdjustmentType {
  CREDIT
  DEBIT
}

enum SellerAdjustmentReasonCode {
  SHIPPING_COMPENSATION
  MANUAL_CREDIT
  MANUAL_DEBIT
  MARKETPLACE_PENALTY
  CORRECTION
}

/// A per-seller double-entry chart mirroring LedgerAccountCode's own shape,
/// scoped to one seller's own view of their balance rather than the
/// platform-wide accounts (spec: "seller-level accounting subledger...
/// every monetary mutation must balance"). RECEIVABLE is the account whose
/// running balance IS the seller's payable balance — see README "Seller
/// ledger/subledger" for the exact posting rules.
enum SellerLedgerAccountCode {
  RECEIVABLE
  SALES_INCOME
  SETTLEMENT_PAID
  ADJUSTMENT
}

enum MarketplaceSettlementImportSource {
  MANUAL
  CSV_IMPORT
  API
}

enum MarketplaceReconciliationStatus {
  MATCHED
  MISMATCH
  MISSING_EXTERNAL
  MISSING_INTERNAL
  DUPLICATE
  REVIEW_REQUIRED
}

/// Per-locale publication state (spec: "do NOT overload one boolean like
/// published=true... define allowed transitions clearly"). Lives on
/// ArticleLocale, never on Article itself — Persian and English publish
/// independently (spec: "do not require both languages before publishing
/// one language"). CMS_ARTICLE_LOCALE_TRANSITIONS in article.service.ts is
/// the single source of truth for which of these five transitions are
/// allowed: DRAFT->VISIBLE, VISIBLE->HIDDEN, HIDDEN->VISIBLE, DRAFT->ARCHIVED,
/// HIDDEN->ARCHIVED. ARCHIVED is a deliberate terminal state this phase —
/// spec: "archived content should not silently return to public state
/// without an explicit action," and no such action is in scope for H15.
enum ArticleLifecycleStatus {
  DRAFT
  VISIBLE
  HIDDEN
  ARCHIVED
}

/// Closed vocabulary of typed content hooks a future Landing/Home surface
/// may read (spec: "typed placements... avoid arbitrary CSS/layout control
/// from CMS — CMS controls content, not visual architecture"). Adding a
/// fifth placement is a one-line enum addition, never a schema redesign.
enum ContentPlacementKey {
  LANDING_HERO
  LANDING_FEATURED_CONTENT
  HOME_EDUCATION
  HOME_ANNOUNCEMENT
}

// ---------------------------------------------------------------------------
// Delivery & Logistics Core (Handoff 08)
// ---------------------------------------------------------------------------

/// Canonical shipping-provider registry (spec section 1) — mirrors
/// PaymentProvider's shape exactly (DEV_SIMULATED-equivalent plus real
/// provider slots). ALOPEYK/SNAPPBOX are adapter boundaries only this
/// phase — see README "Provider integration status" for what is real vs
/// stubbed.
enum ShippingProvider {
  DEV
  ALOPEYK
  SNAPPBOX
}

/// A single, fixed value this phase (spec section 4's "fulfillmentType"
/// field) — kept as a real enum rather than a free string so a future
/// second value (e.g. PICKUP_IN_STORE, LOCAL_DELIVERY) is a plain enum
/// addition, not a schema redesign.
enum FulfillmentType {
  STANDARD_DELIVERY
}

/// Authoritative Fulfillment lifecycle (spec section 5) — enforced
/// exclusively by FulfillmentTransitionService; no other code path may
/// write `status` directly. Deliberately separate from OrderStatus and
/// ShipmentStatus (spec section 1: "keep these states separate").
enum FulfillmentStatus {
  PENDING
  AWAITING_SELLER_PREPARATION
  READY_FOR_PICKUP
  PICKUP_REQUESTED
  PICKUP_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELED
}

/// Canonical, provider-normalized Shipment status (spec section 6) — the
/// one vocabulary customer-facing APIs ever expose. Raw provider status
/// strings are preserved separately (`Shipment.rawProviderStatus`) and
/// never leak into this enum; an unrecognized raw status maps to UNKNOWN,
/// which must never be interpreted as success (see
/// normalizeShippingProviderStatus).
enum ShipmentStatus {
  CREATED
  REQUESTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELED
  UNKNOWN
}

/// Spec section 7. AVAILABLE quotes may be SELECTED (at most one per
/// checkout+seller at a time — enforced in ShippingOrchestrator, not the
/// database); a quote past `expiresAt` is treated as EXPIRED regardless of
/// its stored status.
enum ShippingQuoteStatus {
  AVAILABLE
  UNAVAILABLE
  EXPIRED
  SELECTED
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

/// DB-level integrity: a CHECK constraint (email IS NOT NULL OR phone IS NOT NULL)
/// is added by the schema_hardening migration's raw SQL — Prisma's schema DSL has
/// no multi-column CHECK syntax, so it is not representable here. Application-layer
/// validation in AuthService remains, but this is no longer the only guarantee.
model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String?         @unique
  phone              String?         @unique
  /// Case-preserved as entered; uniqueness is enforced on normalizedUsername
  /// (lowercased) so "Sarah" and "sarah" can never collide.
  username           String?
  normalizedUsername String?         @unique
  /// Argon2id hash (see common/password/password-hash.util.ts). Null for an
  /// account that has never set a password (OTP-only / Google-only).
  passwordHash       String?
  displayName        String
  avatarUrl          String?
  locale             Locale          @default(fa)
  themePreference    ThemePreference @default(SYSTEM)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  authIdentities          AuthIdentity[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  householdMemberships    HouseholdMember[]
  petAccessGrants         PetAccessGrant[]
  activePetPreferences    ActivePetPreference[]
  onboardingProgress      OnboardingProgress[]
  petInterests            UserPetInterest[]
  providerProfiles        ProviderUser[]
  bookings                Booking[]
  bookingSeries           BookingSeries[]
  providerContext         ProviderContextPreference?
  carts                   Cart[]
  checkouts               Checkout[]
  orders                  Order[]
  sellerMemberships       SellerMembership[]
  sellerContext           SellerContextPreference?
  inventoryMovements      InventoryMovement[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationQuietHours  NotificationQuietHours?

  adminUser             AdminUser?
  supportCasesRequested SupportCase[]
  supportMessages       SupportMessage[]
  disputesRaised        Dispute[]
  disputeEvidence       DisputeEvidence[]
  appeals               Appeal[]

  @@map("users")
}

enum AuthProvider {
  GOOGLE
}

/// Links an external OAuth identity (Google, and any future OIDC provider)
/// to exactly one User row. OTP (email/phone) and password auth do not use
/// this table — they resolve directly against User.email/phone/normalizedUsername,
/// which is a 1:1 relationship by construction. AuthIdentity exists so a
/// second sign-in method (Google) can be linked to an existing account
/// without ever creating a duplicate User.
model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  /// The provider's own stable subject id (Google's "sub" claim) — never the
  /// email, which a provider account can change.
  providerAccountId String
  /// Cached verified email from the provider, for display/audit only — never
  /// the join key (providerAccountId is).
  email             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("auth_identities")
}

/// Single-use, short-lived password reset token. Only tokenHash is stored
/// (SHA-256 of the raw token), mirroring how DevOtpProvider never stores a
/// raw OTP code either — a leaked database row alone can never be replayed.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Server-side session record backing the HTTP-only session cookie. The cookie carries only the id.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  rotatedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Household {
  id          String   @id @default(uuid()) @db.Uuid
  name        String?
  city        String?
  region      String?
  countryCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members              HouseholdMember[]
  pets                 Pet[]
  activePetPreferences ActivePetPreference[]
  onboardingProgress   OnboardingProgress[]
  bookings             Booking[]
  careCalendarEvents   CareCalendarEvent[]
  addresses            CustomerAddress[]
  bookingSeries        BookingSeries[]
  carts                Cart[]
  checkouts            Checkout[]
  orders               Order[]
  supportCases         SupportCase[]
  subscription         Subscription?
  subscriptionTrials   SubscriptionTrial[]
  entitlementOverrides SubscriptionEntitlementOverride[]

  medicalDocuments MedicalDocument[]
  clinicalVisits   ClinicalVisit[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([householdId, userId])
  @@map("household_members")
}

// ---------------------------------------------------------------------------
// Pet identity
// ---------------------------------------------------------------------------

model Pet {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  name    String
  species PetSpecies
  breed   String?
  /// NULL = not answered/not recorded. UNKNOWN = user explicitly stated they
  /// don't know. Both states are kept distinct — this is the Known Negative /
  /// Unknown / Incomplete distinction applied to a single field, and later
  /// Health/Care work must preserve the same convention rather than
  /// collapsing "never asked" and "asked, don't know" into one value.
  sex     PetSex?

  birthDate            DateTime? @db.Date
  approximateAgeMonths Int?

  photoUrl String?

  latestWeightValue Decimal?    @db.Decimal(6, 2)
  latestWeightUnit  WeightUnit?

  colorMarkings       String?
  /// See the doc comment on `sex` — NULL vs UNKNOWN carries the same meaning here.
  neuteredStatus      NeuteredStatus?
  microchipNumber     String?
  /// Normalized form of microchipNumber (whitespace/separators stripped, upper-cased)
  /// used for uniqueness checks — see PetsService's normalizeMicrochip(). Raw
  /// microchipNumber is preserved as entered/imported and never rejected; only
  /// microchipNormalized participates in the partial unique index added by the
  /// schema_hardening migration (WHERE microchipNormalized IS NOT NULL), since
  /// legacy/imported values that can't be confidently normalized should not be
  /// blocked from being stored.
  microchipNormalized String?

  lifecycleStatus PetLifecycleStatus @default(ACTIVE)

  /// Soft-delete marker for the archive strategy: removing a pet from normal
  /// operational UI must set this rather than issuing a hard DELETE, so that
  /// PetAccessGrant/health/future financial history referencing this pet is
  /// never silently destroyed. lifecycleStatus (ACTIVE/LOST/DECEASED/MEMORIAL)
  /// continues to represent the pet's real-world state; deletedAt represents
  /// removal from the product, which is a separate axis. Not yet set by any
  /// code path — no delete/archive endpoint exists yet, this is schema
  /// preparation only.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants         PetAccessGrant[]
  activePetPreferences ActivePetPreference[]
  onboardingProgress   OnboardingProgress[]
  interests            UserPetInterest[]

  healthProfile      HealthProfile?
  allergies          Allergy[]
  conditions         Condition[]
  medications        Medication[]
  vaccinationSummary VaccinationSummary?
  nutritionProfile   NutritionProfile?
  careProfile        CareProfile?

  bookings           Booking[]
  careCalendarEvents CareCalendarEvent[]
  bookingSeries      BookingSeries[]
  cartLines          CartLine[]
  orderItems         OrderItem[]
  supportCases       SupportCase[]

  medicalDocuments         MedicalDocument[]
  medicalRecordCorrections MedicalRecordCorrection[]
  labResults               LabResult[]
  imagingStudies           ImagingStudy[]
  referrals                Referral[]
  dentalRecords            DentalRecord[]
  clinicalNutritionPlans   ClinicalNutritionPlan[]
  rehabPlans               RehabPlan[]
  observations             PetObservation[]
  clinicalVisits           ClinicalVisit[]
  carePlans                CarePlan[]
  seniorCareNotes          SeniorCareNote[]
  endOfLifeCarePlan        EndOfLifeCarePlan?

  @@index([householdId])
  @@map("pets")
}

/// The authorization source of truth for pets — independent of
/// HouseholdMember.role, which is only a preset applied at grant-creation
/// time. A user may hold MULTIPLE simultaneous, independent grants for the
/// same pet (e.g. a standing HOUSEHOLD grant plus a 24-hour TEMPORARY vet
/// grant) — grants never overwrite one another. Effective authorization is
/// the boolean OR ("union") of every currently active, non-revoked grant's
/// flags; see PetAccessService.getEffectivePermissions() for the algorithm.
/// A grant is active when: revokedAt IS NULL AND (startsAt IS NULL OR
/// startsAt <= now) AND (expiresAt IS NULL OR expiresAt > now). Revoking
/// access sets revokedAt rather than deleting the row, preserving the grant
/// as an audit record.
///
/// Replaces the old one-row-per-(pet,user) `pet_access` table (schema_hardening
/// migration); deliberately has NO @@unique([petId, userId]).
model PetAccessGrant {
  id     String @id @default(uuid()) @db.Uuid
  petId  String @db.Uuid
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  canViewIdentity       Boolean @default(true)
  canEditIdentity       Boolean @default(false)
  canViewHealth         Boolean @default(false)
  canEditHealth         Boolean @default(false)
  canBookCare           Boolean @default(false)
  canViewCareProfile    Boolean @default(false)
  canEditCareProfile    Boolean @default(false)
  canViewLocation       Boolean @default(false)
  canManageAccess       Boolean @default(false)
  /// Handoff 17: authority to author clinical content (ClinicalVisit,
  /// MedicalDocument, LabResult, ImagingStudy, Referral, CarePlan, dental/
  /// nutrition/rehab records) for this pet as a provider. Deliberately
  /// separate from canEditHealth, which governs an owner/household member's
  /// own edits to the Handoff 02 health basics — providers never get
  /// canEditHealth, owners never get canRecordClinicalData. Set true only on
  /// TEMPORARY grants created for a VET-category booking — see
  /// BookingPetAccessService.
  canRecordClinicalData Boolean @default(false)

  startsAt  DateTime?
  expiresAt DateTime?

  source PetAccessSource @default(HOUSEHOLD)
  /// Free-text context for why this grant exists (e.g. "24h post-visit access", a booking reference). Not shown to end users in this phase.
  reason String?

  /// Who created this grant. Plain UUID (no FK) — audit-style reference, deliberately
  /// not cascaded/relation-tracked so revoking or deleting the granter's account can
  /// never alter grant history.
  grantedByUserId String? @db.Uuid

  /// Revocation is soft: set revokedAt/revokedByUserId rather than deleting the row.
  /// A revoked grant is permanently excluded from the active-grant union.
  revokedAt       DateTime?
  revokedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingPetAccess BookingPetAccess?

  @@index([petId, userId])
  @@index([expiresAt])
  @@index([source])
  @@index([revokedAt])
  @@map("pet_access_grants")
}

/// Active pet is a per-user, per-household preference — never stored on Pet itself.
model ActivePetPreference {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, householdId])
  @@map("active_pet_preferences")
}

/// True uniqueness is enforced by two partial unique indexes added via raw SQL
/// in the schema_hardening migration — not representable as a single @@unique
/// here because Postgres treats NULL as distinct in unique indexes, so a plain
/// UNIQUE(userId, petId, interest) does not stop duplicate (userId, NULL, interest)
/// rows. The two indexes are:
///   UNIQUE (userId, interest)          WHERE petId IS NULL
///   UNIQUE (userId, petId, interest)   WHERE petId IS NOT NULL
/// The @@index below is for query performance only and carries no uniqueness guarantee.
model UserPetInterest {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId     String?     @db.Uuid
  pet       Pet?        @relation(fields: [petId], references: [id], onDelete: Cascade)
  interest  PetInterest
  createdAt DateTime    @default(now())

  @@index([userId, petId, interest])
  @@map("user_pet_interests")
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

/// Deleting/archiving a referenced Household or Pet must never silently
/// destroy the user's onboarding progress row — hence SetNull (not Cascade)
/// on both householdId and petId. There is still exactly one progress row
/// per user (@@unique([userId]) below), covering only the initial onboarding
/// flow; it is not a general per-household/per-pet progress log.
model OnboardingProgress {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String?    @db.Uuid
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  petId       String?    @db.Uuid
  pet         Pet?       @relation(fields: [petId], references: [id], onDelete: SetNull)

  chapter        OnboardingChapter
  step           String
  status         OnboardingStatus  @default(IN_PROGRESS)
  completedSteps Json              @default("[]")

  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId])
  @@map("onboarding_progress")
}

// ---------------------------------------------------------------------------
// Health & Care (Handoff 02)
//
// Every model here uses onDelete: Restrict on its Pet relation — NOT Cascade.
// This is a deliberate continuation of the schema-hardening FK policy: health
// history must not be silently destroyed by a Pet row disappearing. Pets are
// never hard-deleted through the product today (see Pet.deletedAt), so this
// is currently inert in practice, but it is the correct default to have in
// place before any health data exists, per the hardening checkpoint's policy
// table ("future child domains ... must NOT default to CASCADE").
// ---------------------------------------------------------------------------

/// Pet-level health setup summary — NOT a medical diagnosis, a record of how
/// much of the Health Basics picture has been captured. `status` is computed
/// by HealthService from the state of the domains below (allergies,
/// conditions, medications, vaccination, nutrition), not freely settable by
/// clients — see HealthService.recomputeStatus(). `lastReviewedAt` is the one
/// field a client can set directly (PATCH .../health/profile), marking that
/// an owner has reviewed the current summary.
model HealthProfile {
  id    String @id @default(uuid()) @db.Uuid
  petId String @unique @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  status SetupStatus @default(NOT_STARTED)

  allergiesOverallState   HealthAreaKnowledgeState?
  conditionsOverallState  HealthAreaKnowledgeState?
  medicationsOverallState HealthAreaKnowledgeState?

  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("health_profiles")
}

model Allergy {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  name     String
  reaction String?
  /// Never inferred from other fields — always an explicit owner/provider choice.
  severity AllergySeverity?

  knowledgeState AllergyKnowledgeState @default(KNOWN)
  status         AllergyStatus         @default(ACTIVE)

  sourceType  SourceType @default(OWNER)
  sourceLabel String?

  /// Plain UUID, no FK — same audit-reference pattern as PetAccessGrant.grantedByUserId.
  recordedByUserId String?  @db.Uuid
  recordedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([petId])
  @@map("allergies")
}

model Condition {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  name   String
  status ConditionStatus @default(ACTIVE)
  notes  String?

  sourceType  SourceType @default(OWNER)
  sourceLabel String?

  recordedByUserId String?   @db.Uuid
  firstRecordedAt  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@map("conditions")
}

/// No reminder engine and no dosage intelligence in this phase — dosage/unit
/// are stored as entered (dosage never a float: Decimal) and simply displayed.
model Medication {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  name          String
  dosage        Decimal? @db.Decimal(8, 2)
  unit          String?
  frequencyText String?
  route         String?

  status MedicationStatus @default(ACTIVE)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  instructions String?

  sourceType       SourceType @default(OWNER)
  sourceLabel      String?
  recordedByUserId String?    @db.Uuid

  /// Handoff 17: set when a provider prescribes this medication during a
  /// Clinical Visit / as part of a Care Plan item — links the executable
  /// medication record to the clinical context that produced it, without
  /// creating a second "ClinicalMedicationRecord" model duplicating these
  /// same fields (spec: "Keep medication record separate from payment/shop
  /// fulfillment", which this model already satisfies).
  clinicalVisitId String?        @db.Uuid
  clinicalVisit   ClinicalVisit? @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)
  carePlanItemId  String?        @db.Uuid
  carePlanItem    CarePlanItem?  @relation(fields: [carePlanItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@index([status])
  @@index([clinicalVisitId])
  @@map("medications")
}

/// Deliberately a single summary row per pet, not a vaccine event history —
/// out of scope for this phase. `status` is the source of truth for
/// UNKNOWN-vs-OVERDUE: OVERDUE is only ever set explicitly (or derived from
/// an explicit nextDueDate in the past by VaccinationService), never implied
/// by the mere absence of data.
model VaccinationSummary {
  id    String @id @default(uuid()) @db.Uuid
  petId String @unique @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  status VaccinationStatus @default(INCOMPLETE)

  nextDueDate   DateTime? @db.Date
  lastKnownDate DateTime? @db.Date

  notes String?

  sourceType  SourceType @default(OWNER)
  sourceLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vaccination_summaries")
}

model NutritionProfile {
  id    String @id @default(uuid()) @db.Uuid
  petId String @unique @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  dietType             DietType?
  currentFoodText      String?
  feedingFrequencyText String?
  restrictionsText     String?

  status SetupStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nutrition_profiles")
}

/// Free text by design ("use readable text, not checkbox wall") — this is a
/// human-readable behavioral/handling profile, not structured clinical data.
model CareProfile {
  id    String @id @default(uuid()) @db.Uuid
  petId String @unique @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  temperamentText         String?
  aroundPeopleText        String?
  aroundAnimalsText       String?
  leashBehaviorText       String?
  handlingSensitivityText String?
  feedingRoutineText      String?
  toiletRoutineText       String?
  separationBehaviorText  String?
  specialInstructionsText String?

  status SetupStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("care_profiles")
}

// ---------------------------------------------------------------------------
// Provider / Vet Booking (Handoff 03)
// ---------------------------------------------------------------------------

model ProviderOrganization {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String
  type               ProviderType
  verificationStatus ProviderVerificationStatus @default(NOT_STARTED)

  phone       String?
  email       String?
  description String?
  logoUrl     String?
  websiteUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations              ProviderLocation[]
  providerUsers          ProviderUser[]
  services               ProviderService[]
  availabilityRules      ProviderAvailabilityRule[]
  availabilityExceptions ProviderAvailabilityException[]
  bookings               Booking[]
  bookingSeries          BookingSeries[]
  contextPreferences     ProviderContextPreference[]

  medicalDocumentsSourced MedicalDocument[]
  labResults              LabResult[]
  imagingStudies          ImagingStudy[]
  referralsFrom           Referral[]              @relation("ReferralFrom")
  referralsTo             Referral[]              @relation("ReferralTo")
  dentalRecords           DentalRecord[]
  clinicalNutritionPlans  ClinicalNutritionPlan[]
  rehabPlans              RehabPlan[]
  clinicalVisits          ClinicalVisit[]
  carePlans               CarePlan[]
  seniorCareNotes         SeniorCareNote[]
  endOfLifeCarePlans      EndOfLifeCarePlan[]

  @@index([verificationStatus])
  @@map("provider_organizations")
}

model ProviderLocation {
  id                     String               @id @default(uuid()) @db.Uuid
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)

  name        String?
  addressLine String
  city        String
  region      String?
  countryCode String
  latitude    Float?
  longitude   Float?
  phone       String?
  /// IANA timezone (e.g. "Asia/Tehran") — authoritative for this location's
  /// appointment times. See README "Timezone behavior".
  timezone    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services               ProviderService[]
  availabilityRules      ProviderAvailabilityRule[]
  availabilityExceptions ProviderAvailabilityException[]
  bookings               Booking[]

  @@index([providerOrganizationId])
  @@index([city])
  @@map("provider_locations")
}

/// A person's membership in a provider organization. Deliberately NOT a pet
/// data permission source — see the doc comment on ProviderUserRole.
model ProviderUser {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @db.Uuid
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)

  role         ProviderUserRole @default(VET)
  displayTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      ProviderAvailabilityRule[]
  availabilityExceptions ProviderAvailabilityException[]
  bookings               Booking[]
  bookingProviderNotes   BookingProviderNote[]

  medicalDocumentsSourced MedicalDocument[]
  labResultsRecorded      LabResult[]
  imagingStudiesPerformed ImagingStudy[]
  referralsFrom           Referral[]
  dentalRecords           DentalRecord[]
  clinicalNutritionPlans  ClinicalNutritionPlan[]
  rehabPlans              RehabPlan[]
  clinicalVisits          ClinicalVisit[]
  carePlans               CarePlan[]

  @@index([providerOrganizationId])
  @@index([userId])
  @@map("provider_users")
}

model ProviderService {
  id                     String               @id @default(uuid()) @db.Uuid
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)
  locationId             String?              @db.Uuid
  location               ProviderLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  name        String
  description String?
  type        ProviderServiceType
  /// The authoritative taxonomy field — see the doc comment on ServiceCategory.
  /// Never inferred from `type` or `name` at read time.
  category    ServiceCategory

  durationMinutes Int
  priceAmount     Decimal? @db.Decimal(10, 2)
  currency        String?

  supportsDog Boolean @default(true)
  supportsCat Boolean @default(true)

  /// Compatibility bounds (Handoff 04) — nullable means "no restriction on
  /// this axis". Weight is stored normalized to kg (rather than the spec's
  /// literal minWeight/maxWeight) because Pet.latestWeightValue carries its
  /// own WeightUnit (KG or LB); comparing raw values without a shared unit
  /// would silently misjudge compatibility. PetServiceCompatibilityService
  /// converts a pet's weight to kg before comparing.
  minAgeMonths Int?
  maxAgeMonths Int?
  minWeightKg  Decimal? @db.Decimal(6, 2)
  maxWeightKg  Decimal? @db.Decimal(6, 2)

  /// When true, PetServiceCompatibilityService reports NEEDS_REVIEW (never
  /// COMPATIBLE) until the pet's Care Profile / Health Basics setup is
  /// COMPLETE — see spec section 5 ("never call a service compatible when
  /// required context is missing").
  requiresCareProfile  Boolean @default(false)
  requiresHealthBasics Boolean @default(false)

  /// Where this service happens — see the doc comment on LocationMode.
  locationMode LocationMode @default(AT_PROVIDER)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules ProviderAvailabilityRule[]
  bookings          Booking[]
  bookingSeries     BookingSeries[]

  @@index([providerOrganizationId])
  @@index([type])
  @@index([category])
  @@map("provider_services")
}

/// A recurring weekly availability window. Slot generation (SlotGeneratorService)
/// projects these rules across a requested date range — no slot ever exists
/// as its own persisted row; slots are always computed on read.
model ProviderAvailabilityRule {
  id                     String               @id @default(uuid()) @db.Uuid
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)
  locationId             String               @db.Uuid
  location               ProviderLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: SetNull)
  serviceId              String?              @db.Uuid
  service                ProviderService?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// 0 = Sunday .. 6 = Saturday, evaluated in `timezone` below.
  dayOfWeek      Int
  /// "HH:mm" 24-hour local time, e.g. "09:00".
  startLocalTime String
  endLocalTime   String

  effectiveFrom  DateTime? @db.Date
  effectiveUntil DateTime? @db.Date

  timezone String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerOrganizationId, locationId])
  @@map("provider_availability_rules")
}

/// A one-off override of the recurring rules above — either blocking an
/// otherwise-available window (holiday, time off) or opening one that the
/// recurring rules don't cover (a one-time extra clinic day).
model ProviderAvailabilityException {
  id                     String               @id @default(uuid()) @db.Uuid
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)
  locationId             String               @db.Uuid
  location               ProviderLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: SetNull)

  startAt DateTime
  endAt   DateTime
  type    AvailabilityExceptionType
  reason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerOrganizationId, locationId])
  @@index([startAt, endAt])
  @@map("provider_availability_exceptions")
}

/// A household-owned address used when a service happens somewhere other
/// than the provider's own location (see LocationMode). Deliberately its own
/// small model rather than long address strings inlined on Booking, so the
/// same address can be reused/listed across multiple bookings. onDelete on
/// its Booking relations is Restrict (see Booking's own doc comment) — an
/// address referenced by any booking history cannot be silently removed;
/// this phase has no delete endpoint for addresses at all (create + list
/// only — see README Known limitations).
model CustomerAddress {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  label        String?
  recipient    String?
  phone        String?
  addressLine  String
  city         String
  region       String?
  countryCode  String
  latitude     Float?
  longitude    Float?
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingsAsCustomerAddress Booking[]  @relation("BookingCustomerAddress")
  bookingsAsDropoffAddress  Booking[]  @relation("BookingDropoffAddress")
  checkouts                 Checkout[]
  ordersAsShippingAddress   Order[]

  @@index([householdId])
  @@map("customer_addresses")
}

/// The recurring definition behind a weekly series of bookings (Handoff 04
/// section 26) — WALKING/TRAINING/GROOMING only, enforced in
/// RecurringBookingService rather than a DB constraint. Bookings remain the
/// actual occurrences (see Booking.bookingSeriesId below); this row is never
/// itself a bookable/cancellable unit end-users interact with directly this
/// phase — cancelling one occurrence (POST /bookings/:id/cancel) never
/// touches this row or any sibling occurrence, by design (spec: "a
/// failed/cancelled occurrence must not destroy whole series").
model BookingSeries {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerServiceId      String               @db.Uuid
  providerService        ProviderService      @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)

  frequency BookingSeriesFrequency
  status    BookingSeriesStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([householdId])
  @@index([petId])
  @@map("booking_series")
}

/// The persisted booking record. A hold (Redis-only, see BookingHoldService)
/// never becomes a row here until it is confirmed — at which point a row is
/// created directly at CONFIRMED, since there is no real payment-authorization
/// gate in this phase. onDelete is Restrict everywhere (never Cascade) per
/// the FK policy established in the schema-hardening checkpoint: a booking is
/// a factual business record, not something that should silently vanish if
/// its pet/household/provider row is ever removed.
///
/// `category` and `locationMode` (Handoff 04) are deliberately denormalized
/// from ProviderService at booking-confirmation time rather than always
/// joined — a booking must keep showing what it was actually booked as even
/// if the service's own category/locationMode is edited later, and it lets
/// My Bookings / Home / Care Calendar filter and label by category without a
/// join. `startAt`/`endAt` already generically support any duration — a
/// 30-minute vet slot and a multi-night Boarding stay use the exact same two
/// columns; no schema change was needed to support date-range bookings (see
/// README "Multi-day bookings").
model Booking {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerLocationId     String               @db.Uuid
  providerLocation       ProviderLocation     @relation(fields: [providerLocationId], references: [id], onDelete: Restrict)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: SetNull)
  providerServiceId      String               @db.Uuid
  providerService        ProviderService      @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)

  category     ServiceCategory
  locationMode LocationMode

  customerAddressId String?          @db.Uuid
  customerAddress   CustomerAddress? @relation("BookingCustomerAddress", fields: [customerAddressId], references: [id], onDelete: Restrict)
  /// TRANSPORT (pet taxi) only — customerAddressId is the pickup address, this is the dropoff.
  dropoffAddressId  String?          @db.Uuid
  dropoffAddress    CustomerAddress? @relation("BookingDropoffAddress", fields: [dropoffAddressId], references: [id], onDelete: Restrict)

  bookingSeriesId String?        @db.Uuid
  bookingSeries   BookingSeries? @relation(fields: [bookingSeriesId], references: [id], onDelete: SetNull)

  startAt  DateTime
  endAt    DateTime
  /// The provider location's timezone at booking time — authoritative for
  /// this appointment's local time, independent of the viewer's own locale.
  timezone String

  bookingStatus BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(NOT_REQUIRED)

  reasonForVisit String?
  ownerNotes     String?

  cancelledAt     DateTime?
  cancelledReason String?

  /// Handoff 05: set only by the Provider OS's POST .../complete transition
  /// (IN_PROGRESS -> COMPLETED). `completedByProviderUserId` is a plain UUID
  /// reference (no FK), the same audit-reference precedent as
  /// PetAccessGrant.grantedByUserId — deleting a ProviderUser later must
  /// never alter booking history. `completionNote` is the deliberately small
  /// owner-visible summary (spec section 21, e.g. "Luna's grooming was
  /// completed.") — distinct from the internal-only BookingProviderNote
  /// rows below, which are never shown to the customer.
  completedAt               DateTime?
  completedByProviderUserId String?   @db.Uuid
  completionNote            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  petAccess     BookingPetAccess?
  providerNotes BookingProviderNote[]

  clinicalVisits     ClinicalVisit[]
  referralsFulfilled Referral[]

  @@index([petId])
  @@index([householdId])
  @@index([userId])
  @@index([providerLocationId, startAt])
  @@index([bookingSeriesId])
  @@map("bookings")
}

/// The explicit link between a Booking and the TEMPORARY PetAccessGrant it
/// created — see PR spec section 23 (Handoff 03) and section 9 (Handoff 04).
/// Renamed from BookingHealthAccess now that booking-time access spans every
/// service category, not just health data (a groomer's grant is Care
/// Profile-only, for example) — see the migration for the safe rename.
/// Lets the system audit why a grant exists, revoke it when its booking is
/// cancelled, and (later) extend it, without guessing from
/// `PetAccessGrant.reason` free text alone.
model BookingPetAccess {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  petAccessGrantId String         @unique @db.Uuid
  petAccessGrant   PetAccessGrant @relation(fields: [petAccessGrantId], references: [id], onDelete: Restrict)

  scopePreset PetAccessScopePreset

  createdAt DateTime @default(now())

  @@map("booking_pet_access")
}

/// Handoff 05 (Minimal Provider OS): which provider organization's
/// operational context a user is currently working in — the Provider OS
/// equivalent of ActivePetPreference. A user with exactly one ProviderUser
/// membership never needs this set explicitly (ProviderContextService
/// resolves it automatically); a user belonging to multiple organizations
/// must pick one explicitly (spec section 3: "do not infer organization
/// implicitly when multiple exist"). onDelete: Cascade on both sides mirrors
/// ActivePetPreference exactly — this is a pure UI preference, not a
/// factual business record.
model ProviderContextPreference {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @unique @db.Uuid
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provider_context_preferences")
}

/// A lightweight, provider-internal note attached to a Booking (spec section
/// 20) — never shown to the customer. The deliberately small owner-visible
/// counterpart is `Booking.completionNote` (spec section 21), kept as a
/// plain field rather than a second note model since it is always at most
/// one short string per booking. onDelete: Restrict on bookingId mirrors the
/// FK policy for every booking-history child record; SetNull on
/// providerUserId so removing a provider user later never erases note
/// history.
model BookingProviderNote {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @db.Uuid
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  providerUserId String?       @db.Uuid
  providerUser   ProviderUser? @relation(fields: [providerUserId], references: [id], onDelete: SetNull)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("booking_provider_notes")
}

/// A read/display projection over Booking (and, later, other source types).
/// Booking remains the editable source of truth — this row is kept in sync
/// whenever a booking's schedule or status changes and is never edited
/// independently. `sourceId` is a plain UUID reference (no FK), the same
/// precedent as PetAccessGrant.grantedByUserId: the source's own table can
/// vary by sourceType later without this model needing a new nullable FK
/// column per source.
model CareCalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)

  sourceType CareCalendarEventType
  sourceId   String                @db.Uuid

  type   CareCalendarEventType
  status CareCalendarEventStatus @default(SCHEDULED)

  startAt  DateTime
  endAt    DateTime
  timezone String

  /// i18n key, not localized copy — the frontend maps this + `actionType` to
  /// display strings, mirroring the HomeActionKind/labelKey pattern from
  /// Handoff 01/02 rather than storing hard-coded text server-side.
  titleKey   String
  actionType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([householdId, petId])
  @@index([startAt])
  @@map("care_calendar_events")
}

// ---------------------------------------------------------------------------
// Commerce Core (Handoff 06)
// ---------------------------------------------------------------------------

/// A goods seller — deliberately its own model from ProviderOrganization
/// (services). Only VERIFIED + ACTIVE sellers ever expose purchasable
/// SellerOffers (see ShopService); a seller under review or suspended stays
/// fully readable for admin/history purposes, just never discoverable.
model SellerOrganization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  verificationStatus SellerVerificationStatus @default(NOT_STARTED)
  status             SellerStatus             @default(ACTIVE)
  countryCode        String
  city               String?
  logoUrl            String?
  description        String?

  /// Handoff 09 (spec section 3) — all additive/optional so every existing
  /// SellerOrganization row remains valid without a data backfill.
  slug                String? @unique
  supportContactEmail String?
  supportContactPhone String?
  defaultCurrency     String  @default("IRR")
  timezone            String  @default("Asia/Tehran")
  businessMetadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers                          SellerOffer[]
  orders                          Order[]
  fulfillments                    Fulfillment[]
  shippingQuotes                  ShippingQuote[]
  memberships                     SellerMembership[]
  inventoryMovements              InventoryMovement[]
  marketplaceChannelAccounts      MarketplaceChannelAccount[]
  marketplaceOrders               MarketplaceOrder[]
  marketplaceSyncAttempts         MarketplaceSyncAttempt[]
  financialAccount                SellerFinancialAccount?
  commissionRules                 CommissionRule[]
  orderFinancialBreakdowns        OrderFinancialBreakdown[]
  ledgerAccounts                  SellerLedgerAccount[]
  ledgerTransactions              SellerLedgerTransaction[]
  settlements                     SellerSettlement[]
  adjustments                     SellerAdjustment[]
  marketplaceSettlementStatements MarketplaceSettlementStatement[]

  @@index([verificationStatus, status])
  @@map("seller_organizations")
}

/// The Seller OS equivalent of ProviderUser (spec section 4) — replaces
/// Handoff 08's temporary "authenticated user owns the checkout/order"
/// stand-in for seller operations. `@@unique([sellerOrganizationId, userId])`
/// means one user has at most one role per seller organization (a user may
/// still belong to several different sellers).
model SellerMembership {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)
  userId               String             @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   SellerMembershipRole
  status SellerMembershipStatus @default(ACTIVE)

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerOrganizationId, userId])
  @@index([userId])
  @@map("seller_memberships")
}

/// The Seller OS equivalent of ProviderContextPreference — which seller
/// organization a multi-membership user is currently operating in.
model SellerContextPreference {
  userId               String   @id @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerOrganizationId String   @db.Uuid
  updatedAt            DateTime @updatedAt

  @@map("seller_context_preferences")
}

model Brand {
  id      String      @id @default(uuid()) @db.Uuid
  name    String
  slug    String      @unique
  logoUrl String?
  status  BrandStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

/// A minimal, self-referencing hierarchy (spec section 5) — parentId is
/// nullable for a top-level category. onDelete: SetNull on the self-relation
/// means removing a parent category never deletes its children, it just
/// orphans them to the root level.
model ProductCategory {
  id       String            @id @default(uuid()) @db.Uuid
  parentId String?           @db.Uuid
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  name   String
  slug   String                @unique
  status ProductCategoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

/// Catalog identity only — never seller price/inventory (spec section 4:
/// "Do NOT put seller price/inventory on Product"). The compatibility
/// fields below are the Commerce Core's equivalent of ProviderService's
/// minAgeMonths/maxAgeMonths/minWeightKg/maxWeightKg/supportsDog/supportsCat
/// (Handoff 04) — same shape, same "known negative vs. missing data" rules
/// in ProductCompatibilityService, deliberately not a new representation
/// (e.g. not a speciesCompatibility array) so the two compatibility engines
/// stay easy to compare and maintain side by side.
model Product {
  id         String          @id @default(uuid()) @db.Uuid
  brandId    String?         @db.Uuid
  brand      Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  title       String
  slug        String  @unique
  description String?

  supportsDog          Boolean  @default(true)
  supportsCat          Boolean  @default(true)
  minAgeMonths         Int?
  maxAgeMonths         Int?
  minWeightKg          Decimal? @db.Decimal(6, 2)
  maxWeightKg          Decimal? @db.Decimal(6, 2)
  /// Normalized (upper-case) ingredient/allergen tags (e.g. "CHICKEN",
  /// "GRAIN") — matched literally against the pet's own recorded Allergy
  /// names by ProductCompatibilityService. Deliberately a flat string match,
  /// never inferred ingredient parsing or medical reasoning (spec section
  /// 12: "deterministic rules only").
  allergenTags         String[]
  /// When true, NEEDS_REVIEW is forced until the pet's Health Basics are
  /// COMPLETE — mirrors ProviderService.requiresHealthBasics exactly.
  requiresHealthReview Boolean  @default(false)

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/// A purchasable unit of a Product (spec section 7) — e.g. "2kg Chicken" vs.
/// "5kg Chicken". `attributes` is Json for genuinely free-form facets (color,
/// flavor); the two facets that actually drive compatibility/logistics
/// (weight) are kept as real structured columns rather than dumped into
/// that Json, per the spec's explicit "avoid dumping all variant identity
/// into free JSON" instruction.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku     String  @unique
  barcode String?
  title   String?

  attributes Json?

  weightValue Decimal?    @db.Decimal(6, 2)
  weightUnit  WeightUnit?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers     SellerOffer[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// One Variant may have multiple Offers from different sellers (spec
/// section 8) — price/inventory live here, never on Product/Variant.
model SellerOffer {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)
  productVariantId     String             @db.Uuid
  productVariant       ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  /// Integer IRR (Rial), never a fractional/floating amount — see README
  /// "IRR/Toman behavior". The UI divides by 10 to render Toman for display.
  priceAmount     Int
  compareAtAmount Int?
  currency        String @default("IRR")

  /// Seller-scoped SKU (spec section 18) — deliberately never the provider's
  /// own external listing/product ID (see MarketplaceListing). NULL is
  /// allowed and distinct in Postgres unique indexes, so several offers may
  /// go without one; when set, it must be unique within the seller.
  sellerSku String?

  status SellerOfferStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItem         InventoryItem?
  cartLines             CartLine[]
  reservations          InventoryReservation[]
  orderItems            OrderItem[]
  marketplaceListings   MarketplaceListing[]
  marketplaceOrderItems MarketplaceOrderItem[]

  @@unique([sellerOrganizationId, sellerSku])
  @@index([productVariantId])
  @@index([sellerOrganizationId])
  @@map("seller_offers")
}

/// The single authoritative inventory record per Offer (spec section 9) —
/// PostgreSQL, never Redis. `available` (onHand - reserved) is always
/// computed on read, never stored, so it can never drift out of sync with
/// the two real columns. The schema_hardening-style raw-SQL CHECK
/// constraints enforcing onHand >= 0, reserved >= 0, and reserved <= onHand
/// live in this handoff's migration (see migration.sql) — Prisma's DSL
/// can't express multi-column CHECKs, same precedent as the users
/// contact-info CHECK from the original schema hardening pass.
model InventoryItem {
  id            String      @id @default(uuid()) @db.Uuid
  sellerOfferId String      @unique @db.Uuid
  sellerOffer   SellerOffer @relation(fields: [sellerOfferId], references: [id], onDelete: Cascade)

  onHand   Int @default(0)
  reserved Int @default(0)

  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@map("inventory_items")
}

/// A persistent, server-side cart (spec section 18) — never localStorage-only.
/// ABANDONED exists in the vocabulary for a future cleanup job; nothing sets
/// it yet (see README Known limitations).
model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String?    @db.Uuid
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     CartLine[]
  checkouts Checkout[]

  @@index([userId, status])
  @@map("carts")
}

/// `targetPetId` is optional and, when set, purely a compatibility/context
/// hint — never a pet-data permission grant (CartService still verifies the
/// caller has some effective access to that pet before accepting it, the
/// same IDOR-prevention pattern used everywhere else, but no PetAccessGrant
/// is created or consulted beyond that check). No DB-level unique constraint
/// on (cartId, sellerOfferId, targetPetId): Postgres treats NULL as distinct
/// in unique indexes, which would let two "no target pet" lines for the same
/// offer coexist — CartService.addItem() finds-or-increments explicitly
/// instead, sidestepping that quirk entirely (see README Known limitations).
model CartLine {
  id            String      @id @default(uuid()) @db.Uuid
  cartId        String      @db.Uuid
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sellerOfferId String      @db.Uuid
  sellerOffer   SellerOffer @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)
  targetPetId   String?     @db.Uuid
  targetPet     Pet?        @relation(fields: [targetPetId], references: [id], onDelete: SetNull)

  quantity Int

  /// The offer's price at the moment this line was added/last updated —
  /// display-only. Checkout always revalidates against the Offer's current
  /// price and never trusts this snapshot (spec section 20).
  unitPriceSnapshot Int
  currency          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("cart_lines")
}

/// A checkout attempt over a snapshot of the cart's lines at creation time
/// (spec section 25). One Cart may have more than one Checkout row over its
/// lifetime (an expired/failed attempt followed by a fresh one) — onDelete:
/// Restrict on cartId means a checkout, once created, is a permanent
/// financial-adjacent record even if the cart itself is later touched.
model Checkout {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  householdId String?    @db.Uuid
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  cartId      String     @db.Uuid
  cart        Cart       @relation(fields: [cartId], references: [id], onDelete: Restrict)

  addressId      String?          @db.Uuid
  address        CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: Restrict)
  deliveryMethod DeliveryMethod   @default(STANDARD)

  /// Handoff 07 (spec section 11) — null until the payment step; chosen once,
  /// before a PaymentIntent (ONLINE_PAYMENT) or FinancingIntent (INSTALLMENTS)
  /// is created for this checkout.
  paymentMethodType PaymentMethodType?

  status CheckoutStatus @default(DRAFT)

  subtotalAmount Int     @default(0)
  deliveryAmount Int     @default(0)
  discountAmount Int     @default(0)
  totalAmount    Int     @default(0)
  currency       String  @default("IRR")
  /// Placeholder only (spec section 46) — no promotion/campaign engine exists to validate this against.
  promotionCode  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  reservations     InventoryReservation[]
  orders           Order[]
  paymentIntents   PaymentIntent[]
  financingIntents FinancingIntent[]
  shippingQuotes   ShippingQuote[]

  @@index([userId])
  @@index([cartId])
  @@map("checkouts")
}

/// Reserves inventory for the duration of a checkout attempt (spec section
/// 27) — reservation and InventoryItem.reserved move together inside the
/// same transaction (see InventoryReservationService). A 15-minute
/// `expiresAt` (see README) is the documented timeout; correctness at
/// use/confirm time comes from checking `status`/`expiresAt` directly
/// against `now()`, never from assuming a cleanup worker already ran one
/// (spec section 28) — an actual expiry sweep is future work.
model InventoryReservation {
  id            String      @id @default(uuid()) @db.Uuid
  checkoutId    String      @db.Uuid
  checkout      Checkout    @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  sellerOfferId String      @db.Uuid
  sellerOffer   SellerOffer @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)

  quantity Int

  status    InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checkoutId])
  @@index([sellerOfferId, status])
  @@map("inventory_reservations")
}

/// One Order per seller per Checkout (spec section 29, "1 Checkout → N
/// Orders") — `@@unique([checkoutId, sellerOrganizationId])` is what makes
/// order creation on payment confirmation idempotent: a retried
/// confirmation attempt hits this constraint (the same P2002-catch pattern
/// BookingsService already uses for slot double-booking) instead of ever
/// creating a duplicate Order for the same seller. `shippingAddressSnapshot`
/// preserves the delivery address as it was at order time even if the
/// referenced CustomerAddress is later edited — history must never silently
/// change (spec section 31's snapshot principle, applied to the address
/// too).
model Order {
  id                   String             @id @default(uuid()) @db.Uuid
  /// Nullable as of Handoff 09 (spec section 25/27) — a marketplace-origin
  /// Order (see the `marketplaceOrder` relation below) never had a PET LIFE
  /// OS Checkout or a registered buyer User; both stay required/non-null for
  /// every ordinary consumer checkout Order, which is still the only path
  /// that ever sets them. `@@unique([checkoutId, sellerOrganizationId])`
  /// below still holds: Postgres treats each NULL as distinct, so many
  /// marketplace Orders for the same seller coexist freely under it.
  checkoutId           String?            @db.Uuid
  checkout             Checkout?          @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)
  userId               String?            @db.Uuid
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  householdId          String?            @db.Uuid
  household            Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  subtotalAmount Int
  deliveryAmount Int
  discountAmount Int
  totalAmount    Int
  currency       String

  shippingAddressId       String?          @db.Uuid
  shippingAddress         CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  shippingAddressSnapshot Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  items                OrderItem[]
  refunds              Refund[]
  fulfillments         Fulfillment[]
  shippingQuotes       ShippingQuote[]
  /// Present only when this Order originated from a marketplace channel
  /// (spec section 25) — absent for every ordinary PET LIFE OS checkout Order.
  marketplaceOrder     MarketplaceOrder?
  adminRefundApprovals AdminRefundApproval[]
  /// Present once SellerFinanceService has attributed this Order's
  /// economics (spec: "for each qualifying Order, persist... financial
  /// breakdown") — see OrderFinancialBreakdown's own doc comment for why
  /// this is a separate table rather than columns on Order itself
  /// (Handoff 14, additive, keeps this core commerce model untouched).
  financialBreakdown   OrderFinancialBreakdown?

  @@unique([checkoutId, sellerOrganizationId])
  @@index([userId])
  @@index([sellerOrganizationId])
  @@map("orders")
}

/// The immutable commercial snapshot of a purchased line (spec section 31)
/// — an old Order must never be rendered from mutable Product/Offer rows
/// alone, so title/sku/price are all copied at order-creation time.
/// `compatibilitySnapshot` preserves what ProductCompatibilityService
/// reported at purchase time (Json, since PetCompatibilityDto-shaped
/// payloads vary in reason-code count) — a later change to the product's
/// own compatibility metadata must never rewrite order history.
model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  sellerOfferId    String         @db.Uuid
  sellerOffer      SellerOffer    @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)

  productTitleSnapshot String
  variantTitleSnapshot String?
  skuSnapshot          String

  quantity   Int
  unitPrice  Int
  totalPrice Int

  targetPetId           String? @db.Uuid
  targetPet             Pet?    @relation(fields: [targetPetId], references: [id], onDelete: SetNull)
  compatibilitySnapshot Json

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

/// Provider-agnostic payment abstraction (spec section 33-34) — Checkout's
/// own business logic only ever talks to this model and the PaymentGateway
/// interface, never to a specific provider's API shape.
model PaymentIntent {
  id         String   @id @default(uuid()) @db.Uuid
  checkoutId String   @db.Uuid
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  amount   Int
  currency String

  status         PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  provider       PaymentProvider     @default(DEV_SIMULATED)
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts                    PaymentAttempt[]
  transactions                Transaction[]
  refunds                     Refund[]
  providerEvents              PaymentProviderEvent[]
  /// Handoff 16 — a subscription billing attempt (initial purchase, renewal,
  /// or upgrade) creates exactly one PaymentIntent through this same table,
  /// via a minimal internal Checkout/Cart shell never exposed by any
  /// commerce route (see SubscriptionBillingService's own doc comment) —
  /// `checkoutId` above stays required and this codebase's real commerce
  /// checkout flow is completely untouched.
  subscriptionBillingAttempts SubscriptionBillingAttempt[]

  @@index([checkoutId])
  @@map("payment_intents")
}

model PaymentAttempt {
  id                String          @id @default(uuid()) @db.Uuid
  paymentIntentId   String          @db.Uuid
  paymentIntent     PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  providerReference String?

  status         PaymentAttemptStatus @default(STARTED)
  failureCode    String?
  failureMessage String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  transactions Transaction[]

  @@index([paymentIntentId])
  @@map("payment_attempts")
}

/// No ledger/settlement modeling yet (spec section 36) — this is a flat
/// history of charge/refund attempts, one row per gateway-reported result.
model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  paymentIntentId  String          @db.Uuid
  paymentIntent    PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  paymentAttemptId String?         @db.Uuid
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  type     TransactionType
  amount   Int
  currency String
  status   TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([paymentIntentId])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Real Payments + BNPL + Refunds + Reconciliation + Ledger (Handoff 07)
// ---------------------------------------------------------------------------

/// A BNPL/financing attempt for a Checkout — deliberately its own model and
/// state machine (spec sections 4, 6), never overloading PaymentIntent.
/// `selectedPlanId` points at exactly one of this intent's own
/// `planSnapshots` once the user picks one (see FinancingPlanSnapshot).
model FinancingIntent {
  id         String   @id @default(uuid()) @db.Uuid
  checkoutId String   @db.Uuid
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  provider PaymentProvider

  amount   Int
  currency String @default("IRR")

  status FinancingIntentStatus @default(CREATED)

  selectedPlanId    String?                @unique @db.Uuid
  selectedPlan      FinancingPlanSnapshot? @relation("SelectedPlan", fields: [selectedPlanId], references: [id], onDelete: SetNull)
  providerReference String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  planSnapshots  FinancingPlanSnapshot[] @relation("FinancingIntentPlans")
  refunds        Refund[]
  providerEvents PaymentProviderEvent[]

  @@index([checkoutId])
  @@map("financing_intents")
}

/// An immutable snapshot of one provider-offered installment plan at the
/// moment it was selected (spec section 5) — the intent's own
/// `totalPayableAmount`/schedule must never be recomputed from live,
/// mutable provider plan data later.
model FinancingPlanSnapshot {
  id                String          @id @default(uuid()) @db.Uuid
  financingIntentId String          @db.Uuid
  financingIntent   FinancingIntent @relation("FinancingIntentPlans", fields: [financingIntentId], references: [id], onDelete: Cascade)

  providerPlanId     String
  installmentCount   Int
  downPaymentAmount  Int?
  installmentAmount  Int?
  feeAmount          Int?
  totalPayableAmount Int
  currency           String @default("IRR")

  firstDueAt   DateTime?
  scheduleJson Json?

  createdAt DateTime @default(now())

  selectedByIntent FinancingIntent? @relation("SelectedPlan")

  @@index([financingIntentId])
  @@map("financing_plan_snapshots")
}

/// Refund basics (spec sections 23-26) — against a standard PaymentIntent or
/// a FinancingIntent (never both), optionally tied to the specific Order it
/// refunds. Append-only like every other financial record here (spec
/// section 34): a failed refund attempt is a new row's FAILED status, never
/// a correction to a prior row.
model Refund {
  id                String           @id @default(uuid()) @db.Uuid
  paymentIntentId   String?          @db.Uuid
  paymentIntent     PaymentIntent?   @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  financingIntentId String?          @db.Uuid
  financingIntent   FinancingIntent? @relation(fields: [financingIntentId], references: [id], onDelete: Restrict)
  orderId           String?          @db.Uuid
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount   Int
  currency String @default("IRR")

  status            RefundStatus @default(REQUESTED)
  reason            String?
  providerReference String?

  /// Plain UUIDs, no FK — same precedent as Booking.completedByProviderUserId:
  /// a refund's audit trail must survive the requesting user being deleted.
  requestedByUserId      String? @db.Uuid
  requestedByAdminUserId String? @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([paymentIntentId])
  @@index([financingIntentId])
  @@index([orderId])
  @@map("refunds")
}

/// One row per raw provider webhook delivery (spec section 17) — the
/// `@@unique([provider, providerEventId])` constraint is the actual
/// duplicate-webhook/replay guard (spec sections 15-16, 18), checked before
/// any PaymentIntent/FinancingIntent mutation is attempted. Deliberately no
/// raw payload column: minimal retention is preferred over storing gateway
/// payloads that may carry sensitive data (spec section 17's "prefer
/// redaction/minimal retention"); `payloadHash` is enough to detect an
/// unexpected re-delivery with a different body under the same event id.
model PaymentProviderEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  providerEventId String
  eventType       String

  paymentIntentId   String?          @db.Uuid
  paymentIntent     PaymentIntent?   @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  financingIntentId String?          @db.Uuid
  financingIntent   FinancingIntent? @relation(fields: [financingIntentId], references: [id], onDelete: SetNull)

  status ProviderEventStatus @default(RECEIVED)

  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  attemptCount Int       @default(0)
  lastError    String?

  payloadHash String?

  @@unique([provider, providerEventId])
  @@map("payment_provider_events")
}

/// Audit-friendly reconciliation record (spec sections 27-29) — every
/// ReconciliationService run appends one row per intent it checked,
/// regardless of outcome (including a plain "already agreed" NONE action),
/// so "did anyone ever check this?" is always answerable from data, not
/// application logs.
model ReconciliationLog {
  id            String          @id @default(uuid()) @db.Uuid
  provider      PaymentProvider
  /// "PAYMENT_INTENT" | "FINANCING_INTENT"
  referenceType String
  referenceId   String          @db.Uuid
  localStatus   String
  remoteStatus  String
  /// "NONE" | "RESOLVED_SUCCEEDED" | "RESOLVED_FAILED" | "UNKNOWN_REMOTE_STATE"
  action        String
  createdAt     DateTime        @default(now())

  @@index([referenceType, referenceId])
  @@map("reconciliation_logs")
}

/// Double-entry ledger foundation (spec sections 30-34) — a small, seeded
/// chart of accounts (see prisma/seed.ts). Never mutated once created except
/// by appending new, reversing entries (spec section 34); a LedgerTransaction
/// is only ever considered valid when its entries' debits equal its
/// credits (enforced in LedgerService.recordBalanced, not the database,
/// since "sum across sibling rows" isn't expressible as a single-row CHECK).
model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      LedgerAccountCode @unique
  name      String
  currency  String            @default("IRR")
  createdAt DateTime          @default(now())

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  description   String
  /// "PAYMENT" | "REFUND" — which financial event this transaction records.
  referenceType String
  referenceId   String   @db.Uuid
  currency      String   @default("IRR")
  createdAt     DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String            @id @default(uuid()) @db.Uuid
  ledgerTransactionId String            @db.Uuid
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  ledgerAccountId     String            @db.Uuid
  ledgerAccount       LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  direction LedgerEntryDirection
  amount    Int

  createdAt DateTime @default(now())

  @@index([ledgerTransactionId])
  @@index([ledgerAccountId])
  @@map("ledger_entries")
}

/// One per seller (spec: "explicit seller financial identity/accounting
/// relationship"). Deliberately no bank credential fields — `payoutMethodType`
/// is a plain label ("MANUAL" this phase, see README "Payout behavior") and
/// `payoutReferenceMasked` is a display-only masked string a future real
/// payout integration would populate; never a full account number or token.
model SellerFinancialAccount {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @unique @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)

  currency           String                       @default("IRR")
  status             SellerFinancialAccountStatus @default(ACTIVE)
  settlementSchedule SellerSettlementScheduleType @default(MANUAL)

  payoutMethodType      String  @default("MANUAL")
  payoutReferenceMasked String?
  minimumPayoutIrr      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller_financial_accounts")
}

/// A configurable commission rate (spec: "commission may vary by seller,
/// channel, country, effective date"; category-level matching is a
/// documented non-goal this phase — see README "Commission model").
/// `sellerOrganizationId` NULL = the platform default; `channel` NULL =
/// applies to every channel. Resolution always prefers the most specific
/// currently-effective row — see CommissionRuleService.
model CommissionRule {
  id                   String              @id @default(uuid()) @db.Uuid
  sellerOrganizationId String?             @db.Uuid
  sellerOrganization   SellerOrganization? @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)
  channel              OrderOrigin?

  /// Basis points (1/100 of a percent) — 1000 = 10.00%. Never a float.
  basisPoints   Int
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdByAdminId String?    @db.Uuid
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breakdowns OrderFinancialBreakdown[]

  @@index([sellerOrganizationId, channel])
  @@map("commission_rules")
}

/// The immutable, per-Order economics snapshot (spec: "financial values
/// used for settlement should not depend on mutable current product/offer
/// prices... snapshot economics at transaction/order time"). Created
/// exactly once per Order — its own existence (`@@unique([orderId])`) is
/// the idempotency guard against double-attribution, checked by
/// SellerFinanceService before every posting. Refund/adjustment impact is
/// never written back onto this row; it lives in SellerLedgerTransaction
/// rows instead (see that model's own doc comment), so this snapshot never
/// mutates after creation.
model OrderFinancialBreakdown {
  id                   String             @id @default(uuid()) @db.Uuid
  orderId              String             @unique @db.Uuid
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)

  origin OrderOrigin

  grossMerchandiseIrr    Int
  shippingIrr            Int
  discountIrr            Int
  /// Who bears `shippingIrr` (spec: "do not assume all shipping belongs to
  /// seller... use Fulfillment.deliveryResponsibility") — read once, at
  /// attribution time, from the Order's own Fulfillment; PETLIFE when none
  /// exists (a marketplace-origin Order never gets one — see README).
  shippingResponsibility DeliveryResponsibility

  commissionRuleId      String?         @db.Uuid
  commissionRule        CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  /// Snapshotted alongside commissionRuleId so a later edit or deletion of
  /// the rule itself can never retroactively change this Order's own math
  /// (spec: "later commission changes must not retroactively alter old
  /// order economics").
  commissionBasisPoints Int

  /// The platform's actual distributed share of `totalAmount` — computed as
  /// `order.totalAmount - sellerNetIrr`, never an independently-rounded
  /// gross*bps figure, so the two-account platform ledger posting this
  /// produces always balances exactly against what the customer paid (see
  /// README "Commission model" for the full worked example, including the
  /// documented edge case this deliberately leaves unhandled).
  platformCommissionIrr Int
  channelFeeIrr         Int                 @default(0)
  channelFeeConfidence  FinancialConfidence @default(KNOWN)

  sellerGrossIrr Int
  sellerNetIrr   Int

  createdAt DateTime @default(now())

  @@map("order_financial_breakdowns")
}

/// A per-seller double-entry chart (spec: "seller-level accounting
/// subledger... every monetary mutation must balance") — mirrors
/// LedgerAccount's own shape, scoped to one seller. See
/// SellerLedgerAccountCode's doc comment for what RECEIVABLE means.
model SellerLedgerAccount {
  id                   String                  @id @default(uuid()) @db.Uuid
  sellerOrganizationId String                  @db.Uuid
  sellerOrganization   SellerOrganization      @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)
  code                 SellerLedgerAccountCode
  currency             String                  @default("IRR")
  createdAt            DateTime                @default(now())

  entries SellerLedgerEntry[]

  @@unique([sellerOrganizationId, code])
  @@map("seller_ledger_accounts")
}

/// Append-only, exactly like LedgerTransaction (see that model's own doc
/// comment) — nothing here is ever updated except `sellerSettlementId`,
/// which flips exactly once from NULL to a real settlement id when this
/// transaction's RECEIVABLE-account movement is swept into a settlement.
/// That single flip is the entire idempotency/derivation mechanism for
/// "which of this seller's transactions are still outstanding" (spec:
/// "prefer derived balance from ledger/subledger entries") — a settlement
/// calculation simply selects every row still NULL for that seller.
model SellerLedgerTransaction {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)

  description   String
  /// "ORDER_SALE" | "ORDER_REFUND" | "ADJUSTMENT" | "SETTLEMENT_PAYMENT" —
  /// mirrors LedgerTransaction.referenceType's own plain-string precedent.
  referenceType String
  referenceId   String @db.Uuid
  currency      String @default("IRR")

  sellerSettlementId String?           @db.Uuid
  sellerSettlement   SellerSettlement? @relation(fields: [sellerSettlementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  entries SellerLedgerEntry[]

  @@index([sellerOrganizationId, sellerSettlementId])
  @@index([referenceType, referenceId])
  @@map("seller_ledger_transactions")
}

model SellerLedgerEntry {
  id                        String                  @id @default(uuid()) @db.Uuid
  sellerLedgerTransactionId String                  @db.Uuid
  sellerLedgerTransaction   SellerLedgerTransaction @relation(fields: [sellerLedgerTransactionId], references: [id], onDelete: Restrict)
  sellerLedgerAccountId     String                  @db.Uuid
  sellerLedgerAccount       SellerLedgerAccount     @relation(fields: [sellerLedgerAccountId], references: [id], onDelete: Restrict)

  direction LedgerEntryDirection
  amount    Int

  createdAt DateTime @default(now())

  @@index([sellerLedgerTransactionId])
  @@index([sellerLedgerAccountId])
  @@map("seller_ledger_entries")
}

/// A batch of a seller's swept receivable movements (spec: "SellerSettlement
/// ... every settlement should explain exactly what it contains"). `reference`
/// is human-readable ("STL-000123"), generated once from a dedicated
/// Postgres sequence, mirroring SupportCase.caseNumber's own precedent.
/// `initiatedByAdminId`/`approvedByAdminId` plus the hand-appended
/// `seller_settlements_approver_not_initiator` CHECK constraint are the
/// two-person-control mechanism, mirroring AdminRefundApproval's own
/// pattern exactly.
model SellerSettlement {
  id                   String             @id @default(uuid()) @db.Uuid
  reference            String             @unique
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)

  periodStart DateTime
  periodEnd   DateTime
  currency    String   @default("IRR")

  status SellerSettlementStatus @default(CALCULATED)

  grossIrr       Int
  commissionIrr  Int
  refundsIrr     Int
  adjustmentsIrr Int
  netIrr         Int

  initiatedByAdminId String     @db.Uuid
  initiatedByAdmin   AdminUser  @relation("InitiatedSettlements", fields: [initiatedByAdminId], references: [id], onDelete: Restrict)
  approvedByAdminId  String?    @db.Uuid
  approvedByAdmin    AdminUser? @relation("ApprovedSettlements", fields: [approvedByAdminId], references: [id], onDelete: SetNull)

  /// Snapshotted from SellerFinancialAccount.payoutMethodType at calculate()
  /// time — never re-read live, so a later account change never rewrites a
  /// settlement's own history.
  payoutMethodType String?

  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?
  reconciledAt DateTime?
  cancelledAt  DateTime?

  items        SellerSettlementItem[]
  transactions SellerLedgerTransaction[]

  @@index([sellerOrganizationId, status])
  @@map("seller_settlements")
}

/// One row per swept SellerLedgerTransaction (spec: "no opaque final
/// number") — `sourceType`/`sourceId` name exactly which Order/Refund/
/// SellerAdjustment this line came from, without a real FK to any of them
/// (mirrors LedgerTransaction.referenceId's own plain-Uuid precedent) so
/// adding this financial layer never requires a back-relation edit on
/// Order/Refund.
model SellerSettlementItem {
  id                 String           @id @default(uuid()) @db.Uuid
  sellerSettlementId String           @db.Uuid
  sellerSettlement   SellerSettlement @relation(fields: [sellerSettlementId], references: [id], onDelete: Cascade)

  /// "ORDER" | "REFUND" | "ADJUSTMENT"
  sourceType String
  sourceId   String @db.Uuid

  grossAmount Int
  feeAmount   Int
  netAmount   Int
  description String

  createdAt DateTime @default(now())

  @@index([sellerSettlementId])
  @@map("seller_settlement_items")
}

/// An explicit, ledger-backed credit/debit to a seller's balance (spec: "no
/// arbitrary balance editing... every adjustment requires amount, reason,
/// actor, evidence/reference, audit, ledger posting"). Posts immediately on
/// creation (never waits for a settlement to exist) and is picked up by the
/// next settlement calculation exactly like any other unswept
/// SellerLedgerTransaction.
model SellerAdjustment {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)

  type              SellerAdjustmentType
  reasonCode        SellerAdjustmentReasonCode
  amountIrr         Int
  reason            String
  evidenceReference String?

  createdByAdminId String    @db.Uuid
  createdByAdmin   AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@map("seller_adjustments")
}

/// An imported record of what an external marketplace channel reports
/// having settled (spec: "if official settlement APIs are unavailable,
/// build import/reconciliation foundation"). `source` is always MANUAL or
/// CSV_IMPORT this phase — no official Torob/Digikala settlement API
/// exists to build an API-sourced importer against (see README "External
/// provider status"); the API value is modeled so a future real
/// integration is an adapter addition, not a schema change.
model MarketplaceSettlementStatement {
  id                          String                    @id @default(uuid()) @db.Uuid
  provider                    MarketplaceProvider
  marketplaceChannelAccountId String                    @db.Uuid
  marketplaceChannelAccount   MarketplaceChannelAccount @relation(fields: [marketplaceChannelAccountId], references: [id], onDelete: Restrict)
  sellerOrganizationId        String                    @db.Uuid
  sellerOrganization          SellerOrganization        @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)

  source      MarketplaceSettlementImportSource
  periodStart DateTime
  periodEnd   DateTime
  currency    String                            @default("IRR")
  totalAmount Int

  importedByAdminId String    @db.Uuid
  importedByAdmin   AdminUser @relation(fields: [importedByAdminId], references: [id], onDelete: Restrict)

  /// Small reference metadata only — never a raw payload (mirrors
  /// MarketplaceOrder.rawPayloadReference's own doc comment).
  rawReference Json?

  createdAt DateTime @default(now())

  lines                 MarketplaceSettlementStatementLine[]
  reconciliationResults MarketplaceReconciliationResult[]

  @@unique([marketplaceChannelAccountId, periodStart, periodEnd])
  @@map("marketplace_settlement_statements")
}

/// One normalized line per external order the statement covers (spec: "do
/// not build fragile CSV-specific architecture... normalize imported
/// lines") — the same shape regardless of whether it arrived via manual
/// entry or a CSV parse.
model MarketplaceSettlementStatementLine {
  id                               String                         @id @default(uuid()) @db.Uuid
  marketplaceSettlementStatementId String                         @db.Uuid
  marketplaceSettlementStatement   MarketplaceSettlementStatement @relation(fields: [marketplaceSettlementStatementId], references: [id], onDelete: Cascade)

  externalOrderId String
  amount          Int
  feeAmount       Int?
  feeConfidence   FinancialConfidence @default(UNKNOWN)
  description     String?

  createdAt DateTime @default(now())

  reconciliationResult MarketplaceReconciliationResult?

  @@unique([marketplaceSettlementStatementId, externalOrderId])
  @@map("marketplace_settlement_statement_lines")
}

/// The admin reconciliation queue (spec: "reconciliation must NEVER
/// overwrite canonical internal financial records automatically... mismatch
/// -> flag -> admin review -> explicit adjustment/correction if needed").
/// Every row here is a finding, never a mutation — resolving one only ever
/// sets `notes`/`resolvedByAdminId`/`resolvedAt` on this row, and if a
/// correction is warranted, an admin creates a separate SellerAdjustment
/// (a distinct, audited action) rather than this service touching the
/// ledger itself.
model MarketplaceReconciliationResult {
  id String @id @default(uuid()) @db.Uuid

  marketplaceSettlementStatementId     String?                             @db.Uuid
  marketplaceSettlementStatement       MarketplaceSettlementStatement?     @relation(fields: [marketplaceSettlementStatementId], references: [id], onDelete: SetNull, map: "reconciliation_result_statement_fkey")
  marketplaceSettlementStatementLineId String?                             @unique @db.Uuid
  marketplaceSettlementStatementLine   MarketplaceSettlementStatementLine? @relation(fields: [marketplaceSettlementStatementLineId], references: [id], onDelete: SetNull, map: "reconciliation_result_statement_line_fkey")
  marketplaceOrderId                   String?                             @db.Uuid
  marketplaceOrder                     MarketplaceOrder?                   @relation(fields: [marketplaceOrderId], references: [id], onDelete: SetNull)

  status          MarketplaceReconciliationStatus
  expectedAmount  Int?
  statementAmount Int?
  variance        Int?

  notes             String?
  resolvedByAdminId String?    @db.Uuid
  resolvedByAdmin   AdminUser? @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("marketplace_reconciliation_results")
}

/// A persisted shipping-price offer for one seller's share of a Checkout
/// (spec section 7) — scoped to `checkoutId` + `sellerOrgId` rather than
/// `orderId` as the spec's own conceptual shape suggests, because Orders
/// (per Handoff 06/07 "1 Checkout → N Orders") do not exist until payment
/// is confirmed, while quotes must be requestable and selectable *before*
/// payment so the checkout total can be server-recalculated first. `orderId`
/// is still carried, nullable, and is backfilled once the matching seller's
/// Order is created (CheckoutService.finalizeSuccessfulPayment) — after
/// that point it is the durable link a Fulfillment/Shipment's price
/// provenance can be traced through. See README "Checkout shipping flow".
model ShippingQuote {
  id          String             @id @default(uuid()) @db.Uuid
  checkoutId  String             @db.Uuid
  checkout    Checkout           @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  sellerOrgId String             @db.Uuid
  seller      SellerOrganization @relation(fields: [sellerOrgId], references: [id], onDelete: Restrict)
  orderId     String?            @db.Uuid
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  provider     ShippingProvider
  /// Provider-defined free-text label (e.g. "STANDARD", "EXPRESS") — same
  /// "closed enum would churn too often" reasoning as ReconciliationLog.action.
  serviceLevel String

  /// Integer IRR — the sole authoritative shipping price once this quote is
  /// SELECTED (spec section 24: "client cannot supply arbitrary shipping
  /// amount").
  priceIrr Int

  estimatedPickupMinutes   Int?
  estimatedDeliveryMinutes Int?

  providerQuoteId String?

  status    ShippingQuoteStatus @default(AVAILABLE)
  expiresAt DateTime

  /// Internal-only diagnostics (spec section 7) — never returned by a
  /// customer-facing DTO.
  providerPayloadSnapshot Json?

  createdAt DateTime @default(now())

  @@index([checkoutId])
  @@index([sellerOrgId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@map("shipping_quotes")
}

/// One seller Order's physical-fulfillment lifecycle (spec sections 3-4).
/// `sequenceNumber` (always 1 this phase) plus `@@unique([orderId,
/// sequenceNumber])` is deliberately the same idempotency device as
/// `Order.@@unique([checkoutId, sellerOrganizationId])`: it gives
/// concurrency-safe "at most one Fulfillment per create-intent" for free
/// (a P2002-catch reuses the existing row) while leaving the schema able to
/// hold a *second* Fulfillment (sequenceNumber 2) per Order for a future
/// split-shipment feature, without a migration (spec section 3: "the schema
/// must not make split shipment impossible later").
model Fulfillment {
  id                 String             @id @default(uuid()) @db.Uuid
  orderId            String             @db.Uuid
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrgId        String             @db.Uuid
  sellerOrganization SellerOrganization @relation(fields: [sellerOrgId], references: [id], onDelete: Restrict)
  sequenceNumber     Int                @default(1)

  status                 FulfillmentStatus      @default(PENDING)
  fulfillmentType        FulfillmentType        @default(STANDARD_DELIVERY)
  /// Handoff 09 (spec section 27, 73) — additive with a default of PETLIFE,
  /// which is exactly what every Handoff 08 Fulfillment already implicitly
  /// was. A marketplace order's ingestion sets this explicitly instead of
  /// defaulting; PET LIFE OS never auto-requests a courier when this is not PETLIFE.
  deliveryResponsibility DeliveryResponsibility @default(PETLIFE)

  /// Snapshotted once, at Fulfillment-creation time (spec section 8) — a
  /// later CustomerAddress edit, or a SellerOrganization detail change, must
  /// never rewrite this row's history. Only the fields the source model
  /// actually has are populated; everything else is explicitly absent
  /// rather than fabricated (see README "Address snapshots").
  pickupAddressSnapshot   Json
  deliveryAddressSnapshot Json

  readyAt           DateTime?
  pickupRequestedAt DateTime?
  pickupAssignedAt  DateTime?
  pickedUpAt        DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?

  failedAt   DateTime?
  canceledAt DateTime?

  failureCode   String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@unique([orderId, sequenceNumber])
  @@index([orderId])
  @@index([sellerOrgId])
  @@index([status])
  @@map("fulfillments")
}

/// PET LIFE OS's canonical record of one external courier job (spec section
/// 6). `sequenceNumber` (always 1 this phase) plus `@@unique([fulfillmentId,
/// sequenceNumber])` is the concurrency guarantee spec section 21 requires
/// verbatim: two concurrent `createShipment(fulfillmentId)` calls race to
/// insert sequenceNumber 1, the loser's insert hits this constraint
/// (P2002-catch, same pattern as Order/Fulfillment above) and reuses the
/// winner's row instead of ever calling the provider a second time — while
/// still leaving room for a genuine reshipment (sequenceNumber 2) later.
model Shipment {
  id             String      @id @default(uuid()) @db.Uuid
  fulfillmentId  String      @db.Uuid
  fulfillment    Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  sequenceNumber Int         @default(1)

  provider           ShippingProvider
  providerShipmentId String?
  providerQuoteId    String?
  trackingCode       String?

  status ShipmentStatus @default(CREATED)

  pickupAddressSnapshot   Json
  deliveryAddressSnapshot Json

  estimatedPickupAt   DateTime?
  estimatedDeliveryAt DateTime?
  actualPickupAt      DateTime?
  actualDeliveryAt    DateTime?

  /// Preserved separately from the canonical `status` (spec section 6) —
  /// diagnostics only, never returned to a customer-facing DTO.
  rawProviderStatus       String?
  providerPayloadSnapshot Json?

  lastReconciledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]

  @@unique([fulfillmentId, sequenceNumber])
  @@index([fulfillmentId])
  @@index([provider])
  @@index([providerShipmentId])
  @@index([status])
  @@index([trackingCode])
  @@map("shipments")
}

/// Append-oriented provider event history (spec section 17) — same
/// `@@unique([provider, providerEventId])` duplicate-webhook guard as
/// PaymentProviderEvent. When a provider has no stable event id, the
/// ingesting code synthesizes one (documented in
/// shipment-events.service.ts) rather than falling back to a random UUID,
/// so the uniqueness constraint still does real deduplication work (spec:
/// "do not use a random UUID alone for deduplication").
model ShipmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  provider        ShippingProvider
  providerEventId String

  eventType       String
  providerStatus  String?
  canonicalStatus ShipmentStatus

  occurredAt DateTime
  receivedAt DateTime @default(now())

  /// Internal-only diagnostics — never returned by a customer-facing DTO.
  payloadSnapshot Json?

  createdAt DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([shipmentId])
  @@map("shipment_events")
}

// ---------------------------------------------------------------------------
// Seller OS + Marketplace Channel Integrations (Handoff 09), continued
// ---------------------------------------------------------------------------

/// The append-only audit trail for every InventoryItem change (spec section
/// 8) — SellerInventoryService (manual seller edits) and
/// MarketplaceOrderIngestionService (marketplace-driven changes) are the
/// only writers, and both always write exactly one of these per
/// onHand/reserved mutation, in the same transaction. `sellerOrganizationId`
/// is denormalized from the InventoryItem's own SellerOffer purely so seller
/// inventory-history queries never need a join through two tables.
model InventoryMovement {
  id                   String             @id @default(uuid()) @db.Uuid
  inventoryItemId      String             @db.Uuid
  inventoryItem        InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)

  type           InventoryMovementType
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int

  /// A short machine-readable origin tag (e.g. "SELLER_OS", "MARKETPLACE_TOROB", "CHECKOUT") — never a raw provider payload.
  source          String
  sourceReference String?
  reason          String?

  actorUserId String? @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([sellerOrganizationId, createdAt])
  @@map("inventory_movements")
}

/// A seller's connection to one external marketplace (spec section 13) —
/// `@@unique([sellerOrganizationId, provider])` means one account per
/// provider per seller this phase (no multi-storefront-per-provider support
/// yet). `metadata` is safe/non-secret configuration only — see the doc
/// comment on `MarketplaceListing.metadata` and README "Credential handling"
/// for why real secrets never live in this column.
model MarketplaceChannelAccount {
  id                   String             @id @default(uuid()) @db.Uuid
  sellerOrganizationId String             @db.Uuid
  sellerOrganization   SellerOrganization @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)

  provider MarketplaceProvider
  status   MarketplaceChannelAccountStatus @default(DISCONNECTED)

  externalSellerId String?
  displayName      String?

  syncEnabled          Boolean @default(true)
  inventorySyncEnabled Boolean @default(true)
  priceSyncEnabled     Boolean @default(true)
  orderSyncEnabled     Boolean @default(true)

  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt  DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings             MarketplaceListing[]
  orders               MarketplaceOrder[]
  syncAttempts         MarketplaceSyncAttempt[]
  settlementStatements MarketplaceSettlementStatement[]

  @@unique([sellerOrganizationId, provider])
  @@index([provider, status])
  @@map("marketplace_channel_accounts")
}

/// The canonical mapping between one SellerOffer and its representation on
/// one external channel (spec section 15) — `status` (business intent) and
/// `syncStatus` (did the last sync call succeed) are deliberately separate
/// axes, mirroring Fulfillment-status-vs-Shipment-status (spec section 16).
model MarketplaceListing {
  id                          String                    @id @default(uuid()) @db.Uuid
  marketplaceChannelAccountId String                    @db.Uuid
  marketplaceChannelAccount   MarketplaceChannelAccount @relation(fields: [marketplaceChannelAccountId], references: [id], onDelete: Cascade)
  sellerOfferId               String                    @db.Uuid
  sellerOffer                 SellerOffer               @relation(fields: [sellerOfferId], references: [id], onDelete: Cascade)

  provider MarketplaceProvider

  /// Provider-specific identifiers — never assumed equal to any PET LIFE OS
  /// id (spec section 17: "Do not assume PET LIFE OS variant ID == provider
  /// listing ID").
  externalListingId String?
  externalProductId String?
  externalVariantId String?

  status     MarketplaceListingStatus     @default(DRAFT)
  syncStatus MarketplaceListingSyncStatus @default(NEVER_SYNCED)

  publishedPriceIrr      Int?
  publishedInventory     Int?
  lastSyncedAt           DateTime?
  lastProviderObservedAt DateTime?
  lastErrorCode          String?
  lastErrorMessage       String?

  /// Small, safe mapping metadata only (spec section 15) — never a raw
  /// provider payload or a credential.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   MarketplaceOrderItem[]
  syncAttempts MarketplaceSyncAttempt[]

  @@unique([marketplaceChannelAccountId, sellerOfferId])
  @@index([provider, externalListingId])
  @@map("marketplace_listings")
}

/// One order as received from an external marketplace (spec section 25-26).
/// `@@unique([provider, marketplaceChannelAccountId, externalOrderId])` is
/// the critical idempotency guard (spec section 26) — a duplicate provider
/// delivery of the same order hits this constraint (the same P2002-catch
/// pattern as Order/Fulfillment/Shipment) instead of ever creating a second
/// row. `mappedOrderId` is nullable and unique: a marketplace order is only
/// linked to an internal Order once ingestion has validated and committed
/// it, and never to more than one.
model MarketplaceOrder {
  id                          String                    @id @default(uuid()) @db.Uuid
  provider                    MarketplaceProvider
  marketplaceChannelAccountId String                    @db.Uuid
  marketplaceChannelAccount   MarketplaceChannelAccount @relation(fields: [marketplaceChannelAccountId], references: [id], onDelete: Restrict)
  sellerOrganizationId        String                    @db.Uuid
  sellerOrganization          SellerOrganization        @relation(fields: [sellerOrganizationId], references: [id], onDelete: Restrict)

  externalOrderId String
  status          MarketplaceOrderStatus @default(RECEIVED)

  currency    String
  totalAmount Int

  deliveryResponsibility DeliveryResponsibility @default(MARKETPLACE)
  /// Never fabricated (spec section 28) — if PET LIFE OS did not itself
  /// collect payment, this is MARKETPLACE_COLLECTED or CASH_ON_DELIVERY,
  /// never PETLIFE_PAYMENT, and no PaymentIntent row is ever created for it.
  paymentSource          PaymentSourceType      @default(UNKNOWN)

  /// Only what the provider legitimately supplies — never enriched or
  /// guessed (spec section 24: "customer/shipping data only if legitimately
  /// available").
  buyerSnapshot    Json?
  shippingSnapshot Json?

  placedAt          DateTime
  providerUpdatedAt DateTime?

  mappedOrderId String? @unique @db.Uuid
  mappedOrder   Order?  @relation(fields: [mappedOrderId], references: [id], onDelete: SetNull)

  /// Safe reference/summary only — never a raw payload that could carry a credential (spec section 25, 34).
  rawPayloadReference Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                 MarketplaceOrderItem[]
  reconciliationResults MarketplaceReconciliationResult[]

  @@unique([provider, marketplaceChannelAccountId, externalOrderId])
  @@index([sellerOrganizationId, status])
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id                   String              @id @default(uuid()) @db.Uuid
  marketplaceOrderId   String              @db.Uuid
  marketplaceOrder     MarketplaceOrder    @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  marketplaceListingId String?             @db.Uuid
  marketplaceListing   MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: SetNull)
  sellerOfferId        String              @db.Uuid
  sellerOffer          SellerOffer         @relation(fields: [sellerOfferId], references: [id], onDelete: Restrict)

  quantity         Int
  unitPriceAmount  Int
  totalPriceAmount Int

  createdAt DateTime @default(now())

  @@index([marketplaceOrderId])
  @@map("marketplace_order_items")
}

/// A bounded, non-worker-platform record of one sync call attempt (spec
/// section 33-34) — "do not build an unnecessary job platform"; this is a
/// log row written synchronously by MarketplaceSyncOrchestrator, never a
/// queued job with its own scheduler. `responseSummary` is a small, safe
/// summary only — never a full raw provider payload that might carry a
/// credential (spec section 34).
model MarketplaceSyncAttempt {
  id                          String                    @id @default(uuid()) @db.Uuid
  sellerOrganizationId        String                    @db.Uuid
  sellerOrganization          SellerOrganization        @relation(fields: [sellerOrganizationId], references: [id], onDelete: Cascade)
  marketplaceChannelAccountId String                    @db.Uuid
  marketplaceChannelAccount   MarketplaceChannelAccount @relation(fields: [marketplaceChannelAccountId], references: [id], onDelete: Cascade)
  marketplaceListingId        String?                   @db.Uuid
  marketplaceListing          MarketplaceListing?       @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade)

  operation MarketplaceSyncOperation
  status    MarketplaceSyncAttemptStatus @default(PENDING)

  attemptNumber    Int     @default(1)
  requestReference String?
  responseSummary  Json?
  errorCode        String?
  errorMessage     String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([marketplaceChannelAccountId, createdAt])
  @@index([marketplaceListingId])
  @@map("marketplace_sync_attempts")
}

// ---------------------------------------------------------------------------
// Messaging, Notifications & Preferences (Handoff 10)
// ---------------------------------------------------------------------------

/// EMAIL/PUSH are defined now (spec: "future channels must be possible
/// without redesign") but unreachable this phase — no adapter/UI ever
/// produces them yet. Mirrors HealthSeverity/BookingStatus's own precedent
/// of defining vocabulary ahead of the feature that reaches it.
enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

/// MARKETING is deliberately its own category, never folded into any
/// transactional one — spec: "Marketing consent must NEVER be inferred from
/// transactional messaging consent."
enum NotificationCategory {
  SECURITY
  HEALTH
  BOOKING
  SERVICE
  PAYMENT
  COMMERCE
  DELIVERY
  SELLER
  MARKETPLACE
  HOUSEHOLD
  PET_ACCESS
  SYSTEM
  MARKETING
  /// Handoff 11 — support-case replies/status updates, routed through the
  /// same NotificationOrchestrator as every other category (spec: "Support
  /// notifications via H10's NotificationOrchestrator, never call SMS
  /// directly").
  SUPPORT
  /// Handoff 16 — subscription lifecycle events (trial ending, renewal
  /// upcoming/failed, grace started, cancelled, expired, upgraded,
  /// downgrade scheduled). Never PAYMENT — a subscription renewal charge is
  /// a distinct product event from a one-off commerce payment even though
  /// both ultimately reuse PaymentIntent underneath.
  SUBSCRIPTION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// SENT means the provider accepted the message; DELIVERED means the
/// provider *confirmed* delivery — never conflated (spec: "do not report
/// DELIVERED just because Faraz accepted the request"). IN_APP has no
/// external transport, so its own delivery goes straight to DELIVERED at
/// creation (the row's existence *is* the delivery).
enum NotificationDeliveryStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED
}

/// Set on a FAILED/QUEUED-for-retry delivery to drive the bounded-retry
/// policy — TRANSIENT is retried with backoff up to a bounded attempt
/// count; PERMANENT is never retried.
enum NotificationFailureKind {
  TRANSIENT
  PERMANENT
}

enum MessagingProvider {
  DEV
  FARAZ
}

/// The addressable, in-app-visible unit — always has exactly one recipient
/// `userId` (never a bare household/seller broadcast; a notification meant
/// for every member of a household or every OWNER/ADMIN of a seller
/// organization is fanned out as one row per recipient, so isolation is
/// just "WHERE userId = :callerId", never a separate authorization axis).
/// `sellerOrganizationId` is a plain scalar, not a Prisma relation, purely
/// for filtering/correlation on SELLER/MARKETPLACE-category rows — kept
/// deliberately decoupled from SellerOrganization's own schema.
/// `domainEventId` is a plain scalar correlating to `DomainEvent.id` (also
/// no Prisma relation, matching how DomainEvent.aggregateId itself already
/// has no FK) — it is the idempotency anchor: `@@unique([domainEventId,
/// type, userId])` means the same domain event can never create two
/// logical notifications for the same recipient (Postgres treats each NULL
/// domainEventId as distinct, so manually/dev-created notifications with no
/// originating event never collide with each other).
model Notification {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @db.Uuid
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId          String? @db.Uuid
  petId                String? @db.Uuid
  sellerOrganizationId String? @db.Uuid
  domainEventId        String? @db.Uuid

  type     String
  category NotificationCategory
  priority NotificationPriority @default(NORMAL)

  title  String
  body   String
  locale Locale

  deepLink   String?
  entityType String?
  entityId   String?
  actorType  String?
  actorId    String?
  metadata   Json?

  createdAt   DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  expiresAt   DateTime?

  deliveries NotificationDelivery[]

  @@unique([domainEventId, type, userId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([sellerOrganizationId])
  @@map("notifications")
}

/// At most one row per (notification, channel) — a retry updates the SAME
/// row (attemptCount/lastAttemptAt/status), never inserts a new one (spec:
/// "if NotificationDelivery already captures attempts cleanly, do not
/// over-normalize"). `destinationMasked` is the only destination form ever
/// persisted (e.g. "+98********12") — the real phone number is read live
/// from `User.phone` at send time, never duplicated into this table.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  provider       MessagingProvider?

  status            NotificationDeliveryStatus @default(PENDING)
  destinationMasked String?
  providerMessageId String?
  attemptCount      Int                        @default(0)
  scheduledAt       DateTime?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureKind       NotificationFailureKind?
  failureCode       String?
  failureMessage    String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel])
  @@index([status, scheduledAt])
  @@index([provider, providerMessageId])
  @@map("notification_deliveries")
}

/// Category x channel opt-out grid (spec section "Preferences"). No row for
/// a given (user, category, channel) means "enabled" (the default) — a row
/// only ever exists to record an explicit override, so a brand-new user
/// needs no seed rows to have correct default behavior. Security-critical
/// sends bypass this table entirely at the orchestrator level (spec:
/// "security-critical messages may not be fully suppressible") rather than
/// this table pretending to enforce it.
model NotificationPreference {
  id       String               @id @default(uuid()) @db.Uuid
  userId   String               @db.Uuid
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  channel  NotificationChannel
  enabled  Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

/// Deliberately its own singleton-per-user table rather than smearing
/// quiet-hours fields across every NotificationPreference row (a user has
/// one quiet window, not one per category/channel) — a normalization
/// decision documented here rather than following the spec's flat
/// suggested-fields list literally. `start`/`end` are "HH:mm" 24h strings
/// interpreted in `timezone` (IANA, e.g. "Asia/Tehran") — clock/timezone
/// semantics only, deliberately never Jalali/Gregorian-calendar-coupled.
model NotificationQuietHours {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  startTime String   @default("22:00")
  endTime   String   @default("08:00")
  timezone  String   @default("Asia/Tehran")
  updatedAt DateTime @updatedAt

  @@map("notification_quiet_hours")
}

// ---------------------------------------------------------------------------
// Admin CRM, Support, Disputes, Trust & Safety, Audit (Handoff 11)
// ---------------------------------------------------------------------------

/// Least-privilege roles (spec: "do not make every admin all-powerful").
/// Permission resolution is a pure code-level static map
/// (ROLE_PERMISSIONS in admin-permissions.ts), mirroring how
/// PROVIDER_CAPABILITIES/SHIPPING_PROVIDER_CAPABILITIES are static maps
/// rather than DB-stored rows — no AdminPermission table exists; backend
/// authorization is the source of truth, never the frontend.
/// NOTE (Handoff 15): `CONTENT` (below) predates this handoff and means
/// trust-and-safety *content moderation* (LISTING/REVIEW/COMMUNITY_CONTENT
/// TrustCase subjects) — it is NOT a CMS editorial role and is deliberately
/// left untouched. `EDITOR` is the new, distinct CMS role; the naming
/// collision with "content" is unfortunate but pre-existing, so a new name
/// was chosen rather than repurposing or renaming the existing role.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  TRUST_SAFETY
  FINANCE
  OPERATIONS
  CONTENT
  VERIFICATION
  READ_ONLY
  EDITOR
}

enum AdminMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum AdminPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  WAITING_ON_INTERNAL
  RESOLVED
  CLOSED
}

enum SupportCaseCategory {
  ACCOUNT
  PET
  HEALTH
  BOOKING
  SERVICE
  PAYMENT
  REFUND
  ORDER
  DELIVERY
  SELLER
  PROVIDER
  MARKETPLACE
  TRUST_SAFETY
  OTHER
}

enum SupportMessageAuthorType {
  USER
  ADMIN
  SYSTEM
}

/// Enforced at the query layer, never just UI hiding (spec: "internal notes
/// must never leak to end users. Be strict here.") — the consumer-facing
/// support endpoints this handoff does not add never select INTERNAL rows
/// in the first place, and no consumer route exists that could.
enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

enum InternalNoteEntityType {
  USER
  HOUSEHOLD
  PET
  SUPPORT_CASE
  DISPUTE
  TRUST_CASE
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Deliberately a generic (subjectType, subjectId) pair rather than one FK
/// column per possible related entity — mirrors Notification's own
/// entityType/entityId pattern (Handoff 10).
enum DisputeSubjectType {
  BOOKING
  ORDER
  PAYMENT
  REFUND
  SHIPMENT
  PROVIDER
  SELLER
}

/// Domain outcome and payment/refund state are deliberately kept separate
/// (spec: "be careful: domain outcome and payment/refund state must remain
/// separate... do not collapse these into one status") — RESOLVED_* here
/// describes who the dispute was decided in favor of, never whether a
/// refund happened. A resolution "triggering" a refund means an admin
/// separately calls the existing refund flow afterward; nothing here does
/// it automatically, and Dispute carries no FK to Refund.
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_EVIDENCE
  RESOLVED_CUSTOMER
  RESOLVED_PROVIDER
  RESOLVED_SELLER
  PARTIAL_RESOLUTION
  REJECTED
  CLOSED
}

enum DisputeEvidenceActorType {
  USER
  ADMIN
}

enum TrustSubjectType {
  USER
  HOUSEHOLD
  PROVIDER
  SELLER
  LISTING
  REVIEW
  COMMUNITY_CONTENT
  PET_INCIDENT
}

enum TrustCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TrustCaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum TrustActionType {
  WARNING
  RESTRICT
  SUSPEND
  REMOVE_CONTENT
  REQUIRE_REVERIFICATION
  RESTORE
  NO_ACTION
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  OVERTURNED
  PARTIALLY_OVERTURNED
}

/// Two-person control foundation for high-risk refunds (spec: "refund above
/// threshold -> REQUESTED -> APPROVED -> EXECUTED"). Below
/// `ADMIN_REFUND_APPROVAL_THRESHOLD_IRR`, a single FINANCE-permission admin
/// may go straight to EXECUTED; at/above it, a *different* admin than the
/// requester must APPROVE before EXECUTED is reachable — enforced in
/// AdminRefundService, not just documented.
enum AdminRefundApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
}

/// Internal platform access is a completely separate identity axis from
/// consumer session/PetAccessGrant/SellerMembership/ProviderUser — a
/// consumer session alone never grants any /admin route (spec: "no
/// implicit access through normal user session alone"). Mirrors
/// SellerMembership/ProviderUser's own shape (role + status keyed to a
/// real User) rather than inventing a parallel credential system.
model AdminUser {
  id     String                @id @default(uuid()) @db.Uuid
  userId String                @unique @db.Uuid
  user   User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   AdminRole
  status AdminMembershipStatus @default(ACTIVE)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  assignedSupportCases          SupportCase[]                     @relation("AssignedSupportCases")
  authoredSupportCases          SupportCase[]                     @relation("CreatedSupportCases")
  supportMessages               SupportMessage[]
  internalNotes                 InternalNote[]
  assignedTasks                 AdminTask[]                       @relation("AssignedTasks")
  createdTasks                  AdminTask[]                       @relation("CreatedTasks")
  assignedDisputes              Dispute[]                         @relation("AssignedDisputes")
  disputeEvidence               DisputeEvidence[]
  assignedTrustCases            TrustCase[]                       @relation("AssignedTrustCases")
  openedTrustCases              TrustCase[]                       @relation("OpenedTrustCases")
  trustActions                  TrustAction[]
  reviewedAppeals               Appeal[]
  auditLogs                     AdminAuditLog[]
  requestedRefunds              AdminRefundApproval[]             @relation("RequestedRefunds")
  approvedRefunds               AdminRefundApproval[]             @relation("ApprovedRefunds")
  createdCommissionRules        CommissionRule[]
  initiatedSettlements          SellerSettlement[]                @relation("InitiatedSettlements")
  approvedSettlements           SellerSettlement[]                @relation("ApprovedSettlements")
  createdSellerAdjustments      SellerAdjustment[]
  importedMarketplaceStatements MarketplaceSettlementStatement[]
  resolvedReconciliations       MarketplaceReconciliationResult[]
  uploadedMediaAssets           MediaAsset[]
  createdArticles               Article[]                         @relation("ArticleCreatedBy")
  lastEditedArticleLocales      ArticleLocale[]                   @relation("ArticleLocaleLastEditedBy")
  contentVersions               ContentVersion[]
  updatedContentPlacements      ContentPlacement[]
  subscriptionChanges           SubscriptionChange[]
  grantedEntitlementOverrides   SubscriptionEntitlementOverride[]

  @@map("admin_users")
}

model SupportCase {
  id         String @id @default(uuid()) @db.Uuid
  /// Human-readable reference (e.g. "CASE-000123"), generated from a
  /// dedicated Postgres sequence — never derived from `id` (a UUID makes a
  /// poor reference to read aloud on a support call).
  caseNumber String @unique

  requesterUserId String     @db.Uuid
  requesterUser   User       @relation(fields: [requesterUserId], references: [id], onDelete: Restrict)
  householdId     String?    @db.Uuid
  household       Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  petId           String?    @db.Uuid
  pet             Pet?       @relation(fields: [petId], references: [id], onDelete: SetNull)

  /// Generic link to whatever the case is actually about (an Order id, a
  /// Booking id, ...) — deliberately not a typed FK per possible target,
  /// mirroring Notification/Dispute's own entityType/entityId shape.
  relatedEntityType String?
  relatedEntityId   String?

  subject     String
  description String
  category    SupportCaseCategory
  priority    AdminPriority       @default(NORMAL)
  status      SupportCaseStatus   @default(OPEN)

  assignedAdminId  String?    @db.Uuid
  assignedAdmin    AdminUser? @relation("AssignedSupportCases", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdByAdminId String?    @db.Uuid
  createdByAdmin   AdminUser? @relation("CreatedSupportCases", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  /// SLA foundation fields — raw timestamps only, no derived-metric engine.
  /// First-response-time and resolution-time are computed on read from
  /// these plus createdAt/resolvedAt.
  firstResponseAt    DateTime?
  lastUserMessageAt  DateTime?
  lastAdminMessageAt DateTime?

  messages SupportMessage[]
  disputes Dispute[]

  @@index([requesterUserId])
  @@index([status, priority])
  @@index([assignedAdminId])
  @@map("support_cases")
}

model SupportMessage {
  id     String      @id @default(uuid()) @db.Uuid
  caseId String      @db.Uuid
  case   SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorType    SupportMessageAuthorType
  authorUserId  String?                  @db.Uuid
  authorUser    User?                    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdminId String?                  @db.Uuid
  authorAdmin   AdminUser?               @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  body       String
  visibility SupportMessageVisibility

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@map("support_messages")
}

/// Append-only by convention (no delete endpoint exists; an edit updates
/// `updatedAt` but the row is never removed — spec: "do not allow silent
/// deletion without audit"). Polymorphic (entityType, entityId) — one table
/// for every CRM entity that can carry internal notes, not one table per
/// entity type.
model InternalNote {
  id            String                 @id @default(uuid()) @db.Uuid
  entityType    InternalNoteEntityType
  entityId      String
  authorAdminId String                 @db.Uuid
  authorAdmin   AdminUser              @relation(fields: [authorAdminId], references: [id], onDelete: Restrict)
  body          String

  createdAt DateTime  @default(now())
  updatedAt DateTime?

  @@index([entityType, entityId, createdAt])
  @@map("internal_notes")
}

model AdminTask {
  id              String          @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  assigneeAdminId String?         @db.Uuid
  assigneeAdmin   AdminUser?      @relation("AssignedTasks", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  dueAt           DateTime?
  status          AdminTaskStatus @default(OPEN)
  priority        AdminPriority   @default(NORMAL)

  relatedEntityType String?
  relatedEntityId   String?

  createdByAdminId String    @db.Uuid
  createdByAdmin   AdminUser @relation("CreatedTasks", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([assigneeAdminId])
  @@map("admin_tasks")
}

model Dispute {
  id          String             @id @default(uuid()) @db.Uuid
  subjectType DisputeSubjectType
  subjectId   String

  raisedByUserId String?      @db.Uuid
  raisedByUser   User?        @relation(fields: [raisedByUserId], references: [id], onDelete: SetNull)
  supportCaseId  String?      @db.Uuid
  supportCase    SupportCase? @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  claim  String
  status DisputeStatus @default(OPEN)

  assignedAdminId String?    @db.Uuid
  assignedAdmin   AdminUser? @relation("AssignedDisputes", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolutionSummary String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  evidence DisputeEvidence[]

  @@index([subjectType, subjectId])
  @@index([status])
  @@index([assignedAdminId])
  @@map("disputes")
}

/// MVP evidence is a text statement plus an optional metadata-only
/// attachment reference (spec: "if attachment upload is too much,
/// implement metadata hooks only and document limitation") — no file
/// upload endpoint exists this phase; `attachmentRef` is never populated by
/// any code path today.
model DisputeEvidence {
  id        String  @id @default(uuid()) @db.Uuid
  disputeId String  @db.Uuid
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  actorType    DisputeEvidenceActorType
  actorUserId  String?                  @db.Uuid
  actorUser    User?                    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdminId String?                  @db.Uuid
  actorAdmin   AdminUser?               @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  statement     String
  attachmentRef String?

  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_evidence")
}

model TrustCase {
  id          String            @id @default(uuid()) @db.Uuid
  subjectType TrustSubjectType
  subjectId   String
  reason      String
  severity    TrustCaseSeverity @default(MEDIUM)
  status      TrustCaseStatus   @default(OPEN)

  assignedAdminId String?    @db.Uuid
  assignedAdmin   AdminUser? @relation("AssignedTrustCases", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  openedByAdminId String     @db.Uuid
  openedByAdmin   AdminUser  @relation("OpenedTrustCases", fields: [openedByAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  actions TrustAction[]

  @@index([subjectType, subjectId])
  @@index([status, severity])
  @@map("trust_cases")
}

/// Never a hard delete of the underlying business/user record (spec: "do
/// not blindly hard-delete business/user records; prefer explicit
/// operational states") — a SUSPEND/RESTRICT action is recorded here and
/// separately applied by AdminTrustService to the subject's own existing
/// status field (e.g. SellerOrganization.status, ProviderOrganization has
/// no suspend field yet — see Known limitations), never by deleting a row.
model TrustAction {
  id          String    @id @default(uuid()) @db.Uuid
  trustCaseId String    @db.Uuid
  trustCase   TrustCase @relation(fields: [trustCaseId], references: [id], onDelete: Cascade)

  actionType TrustActionType
  reason     String

  performedByAdminId String    @db.Uuid
  performedByAdmin   AdminUser @relation(fields: [performedByAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  appeal Appeal?

  @@index([trustCaseId])
  @@map("trust_actions")
}

/// Backend foundation only this phase (spec: "if appeals UI is too much for
/// H11, backend foundation is acceptable, but document it clearly") — a
/// minimal read/create/resolve API exists, but no dedicated appeals
/// frontend page.
model Appeal {
  id            String      @id @default(uuid()) @db.Uuid
  trustActionId String      @unique @db.Uuid
  trustAction   TrustAction @relation(fields: [trustActionId], references: [id], onDelete: Cascade)

  appellantUserId String @db.Uuid
  appellantUser   User   @relation(fields: [appellantUserId], references: [id], onDelete: Restrict)

  reason     String
  status     AppealStatus @default(SUBMITTED)
  resolution String?

  reviewerAdminId String?    @db.Uuid
  reviewerAdmin   AdminUser? @relation(fields: [reviewerAdminId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@map("appeals")
}

/// Two-person control foundation for high-risk refunds — see
/// AdminRefundApprovalStatus's own doc comment. Wraps (never replaces)
/// RefundsService.request(): EXECUTED is the only status that has actually
/// called it. `idempotencyKey` prevents a double-click from creating two
/// approval rows for the same logical request.
model AdminRefundApproval {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount         Int
  reason         String
  idempotencyKey String? @unique

  status AdminRefundApprovalStatus @default(REQUESTED)

  requestedByAdminId String     @db.Uuid
  requestedByAdmin   AdminUser  @relation("RequestedRefunds", fields: [requestedByAdminId], references: [id], onDelete: Restrict)
  approvedByAdminId  String?    @db.Uuid
  approvedByAdmin    AdminUser? @relation("ApprovedRefunds", fields: [approvedByAdminId], references: [id], onDelete: SetNull)

  refundId String? @unique @db.Uuid

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  executedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@map("admin_refund_approvals")
}

/// Every consequential admin mutation writes one row here (spec: "at
/// minimum: admin actor, action, entity type, entity ID, before/after
/// summary where appropriate, reason, requestId, createdAt"). `action` is
/// deliberately plain text, not a Postgres enum — mirrors DomainEvent.type
/// exactly (action vocabulary will grow; a DB enum would need a migration
/// per new one). Type safety instead lives in `AdminAuditAction`, a
/// TypeScript union in admin-audit-log.service.ts.
model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  action        String
  entityType    String
  entityId      String?
  reason        String?
  beforeSummary Json?
  afterSummary  Json?
  requestId     String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Domain events (transactional-outbox-shaped; dispatched in-process for now)
// ---------------------------------------------------------------------------

/// `type` is deliberately plain text, not a Postgres enum — event types will
/// grow significantly over the product's life, and a DB enum would mean a
/// migration per new event. Type safety instead lives in application code:
/// DomainEventType (a TypeScript union derived from DOMAIN_EVENT_TYPES in
/// domain-events.service.ts) is the canonical registry; a typo'd event name
/// fails to compile rather than silently inserting an unrecognized string.
///
/// The extra columns below (eventVersion, aggregateType/aggregateId,
/// attemptCount, lastError) make this row usable as a real transactional
/// outbox later — a poller can pick up unprocessed rows, retry with backoff,
/// and record failures — without any schema change when that poller is built.
model DomainEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  eventVersion  Int       @default(1)
  payload       Json
  aggregateType String?
  aggregateId   String?
  attemptCount  Int       @default(0)
  lastError     String?
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([processedAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// CMS + Blog + Content Management (Handoff 15)
// ---------------------------------------------------------------------------

/// A public byline (spec: "ContentAuthor") — deliberately its own identity,
/// never the same row as AdminUser: a byline like "Dr. Sara Ahmadi, DVM" or
/// "PET LIFE OS Editorial Team" is an editorial persona a reader sees, while
/// AdminUser is the actual login identity AdminAuditLogService attributes
/// every mutation to. One admin can write under several authors; one author
/// byline can be shared by several admins.
model ContentAuthor {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  bio  String?

  avatarMediaAssetId String?     @db.Uuid
  avatarMediaAsset   MediaAsset? @relation(fields: [avatarMediaAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@map("content_authors")
}

/// Flat taxonomy (spec: "do not over-generalize into a completely arbitrary
/// no-code page builder" — the same restraint applies to taxonomy: no
/// parent/child category nesting this phase). The category itself is
/// locale-neutral; CategoryLocale carries the localized name/slug/description.
model Category {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales  CategoryLocale[]
  articles Article[]

  @@map("content_categories")
}

model CategoryLocale {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     Locale

  name        String
  /// Explicit, never auto-derived from `name` at read time (spec: "slug
  /// handling must be explicit... avoid collisions per locale") — validated
  /// and uniqueness-checked by AdminCategoryService before every write.
  slug        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("content_category_locales")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  locales     TagLocale[]
  articleTags ArticleTag[]

  @@map("content_tags")
}

model TagLocale {
  id     String @id @default(uuid()) @db.Uuid
  tagId  String @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  locale Locale

  name String
  slug String

  createdAt DateTime @default(now())

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("content_tag_locales")
}

/// CMS-owned media only (spec: "strongly separate CMS media authorization
/// from private pet documents") — a completely separate model and storage
/// key namespace (`cms/media/...` vs PetsService's own `pets/...`) from any
/// pet/health document, reusing the same StorageDriver abstraction Handoff
/// 01 already built. `url` is a plain public delivery URL (identical
/// "signed PUT to upload, plain public URL to read" semantics
/// `createPetPhotoUploadTarget` already established) — deliberate, since
/// article cover/body images are meant to be public. `widthPx`/`heightPx`
/// are set by a follow-up PATCH once the admin editor's browser has decoded
/// the image client-side (see README "Media" — no native image-processing
/// dependency was added for this phase).
model MediaAsset {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique
  url           String
  mimeType      String
  fileSizeBytes Int
  widthPx       Int?
  heightPx      Int?
  altText       String?

  createdByAdminId String    @db.Uuid
  createdByAdmin   AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  /// Soft-disable only (spec: "media deleted/disabled" as an audit action) —
  /// mirrors Pet.deletedAt's own "never hard-delete, exclude from listings"
  /// precedent; a disabled asset's existing public URL keeps resolving
  /// (already-published articles never get a broken image) but it can no
  /// longer be selected for a new cover/body image.
  disabledAt DateTime?
  createdAt  DateTime  @default(now())

  authors          ContentAuthor[]
  coverForArticles Article[]       @relation("ArticleCoverMedia")
  contentBlocks    ContentBlock[]

  @@map("content_media_assets")
}

/// The language-neutral shell (spec: "independent title, slug, excerpt,
/// body... locale-specific publication readiness" lives one level down, on
/// ArticleLocale). Author, category, cover image, and tags are shared
/// across every locale of one article — only the editorial content and its
/// lifecycle status are per-locale.
model Article {
  id String @id @default(uuid()) @db.Uuid

  authorId String?        @db.Uuid
  author   ContentAuthor? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  coverMediaAssetId String?     @db.Uuid
  coverMediaAsset   MediaAsset? @relation("ArticleCoverMedia", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)

  createdByAdminId String    @db.Uuid
  createdByAdmin   AdminUser @relation("ArticleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales  ArticleLocale[]
  tags     ArticleTag[]
  versions ContentVersion[]
  blocks   ContentBlock[]

  @@index([authorId])
  @@index([categoryId])
  @@map("content_articles")
}

/// The actual editorial content, one row per (article, locale) — see
/// ArticleLifecycleStatus's own doc comment for the state machine.
/// `publishedAt` is set once, the first time `status` reaches VISIBLE, and
/// is never cleared by a later HIDDEN/ARCHIVED transition — the article
/// page can therefore always show both "published" and "updated" (spec:
/// "author, updated/published time").
model ArticleLocale {
  id        String                 @id @default(uuid()) @db.Uuid
  articleId String                 @db.Uuid
  article   Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale    Locale
  status    ArticleLifecycleStatus @default(DRAFT)

  title          String
  /// Explicit, admin-supplied — never silently regenerated once set, so a
  /// published URL never moves out from under a reader/search engine.
  slug           String
  excerpt        String?
  /// Structured rich text (RichTextDocument, @petlife/types) — never raw
  /// HTML. See README "Editor format" for why: a closed block/mark
  /// vocabulary makes injection structurally impossible rather than
  /// something a sanitizer library has to catch after the fact, and the
  /// same JSON renders through the sanitizing renderer in both the admin
  /// preview and the public article page.
  body           Json
  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?

  lastEditedByAdminId String?    @db.Uuid
  lastEditedByAdmin   AdminUser? @relation("ArticleLocaleLastEditedBy", fields: [lastEditedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([locale, status])
  @@map("content_article_locales")
}

model ArticleTag {
  articleId String  @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String  @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([articleId, tagId])
  @@map("content_article_tags")
}

/// A recoverable snapshot of one ArticleLocale, scoped per (article, locale)
/// since Persian and English are edited independently (spec: "manage
/// Persian and English independently"). `versionNumber` is computed inside
/// the same transaction as the save it snapshots — safe against concurrent
/// saves to the *same* article/locale because that write already holds a
/// row lock on the ArticleLocale being updated; a genuinely global
/// monotonic counter (the Postgres-sequence device SellerSettlement.reference
/// uses) is unnecessary here since a version number's only job is ordering
/// one article's own history, not serving as an external reference.
/// Restoring a version calls the exact same save path that creates a new
/// version — history is append-only, never mutated or rewound in place.
model ContentVersion {
  id            String  @id @default(uuid()) @db.Uuid
  articleId     String  @db.Uuid
  article       Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale        Locale
  versionNumber Int

  editorAdminId String    @db.Uuid
  editorAdmin   AdminUser @relation(fields: [editorAdminId], references: [id], onDelete: Restrict)
  changeNote    String?

  /// { title, slug, excerpt, body, seoTitle, seoDescription } — the exact
  /// ArticleLocale editorial fields at save time; never the lifecycle status,
  /// which is a separate, deliberate admin action rather than content history.
  snapshot Json

  createdAt DateTime @default(now())

  @@unique([articleId, locale, versionNumber])
  @@index([articleId, locale])
  @@map("content_versions")
}

/// One typed content hook per placement key (spec: "typed content
/// placements... CMS controls content, not visual architecture"). Codex's
/// existing Landing visual implementation is untouched by this table —
/// nothing here is consumed until a future Landing/Home change deliberately
/// reads it.
model ContentPlacement {
  id  String              @id @default(uuid()) @db.Uuid
  key ContentPlacementKey @unique

  updatedByAdminId String?    @db.Uuid
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks ContentBlock[]

  @@map("content_placements")
}

/// One content slot within a placement (e.g. one hero, or one card in a
/// row of featured content) — content-only fields (heading/body/CTA/media/
/// an optional linked Article), deliberately no layout/style/CSS field of
/// any kind, so this table structurally cannot become a visual page builder.
model ContentBlock {
  id          String           @id @default(uuid()) @db.Uuid
  placementId String           @db.Uuid
  placement   ContentPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  sortOrder   Int

  linkedArticleId String?     @db.Uuid
  linkedArticle   Article?    @relation(fields: [linkedArticleId], references: [id], onDelete: SetNull)
  mediaAssetId    String?     @db.Uuid
  mediaAsset      MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales ContentBlockLocale[]

  @@unique([placementId, sortOrder])
  @@map("content_blocks")
}

model ContentBlockLocale {
  id             String       @id @default(uuid()) @db.Uuid
  contentBlockId String       @db.Uuid
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  locale         Locale

  heading  String?
  body     String?
  /// Validated to be a same-origin relative path or an https:// URL —
  /// never javascript:/data: — by AdminContentPlacementService before
  /// every write (spec: "prevent arbitrary script injection").
  ctaLabel String?
  ctaHref  String?

  @@unique([contentBlockId, locale])
  @@map("content_block_locales")
}

// ---------------------------------------------------------------------------
// Subscription + Membership + Metering (Handoff 16)
// ---------------------------------------------------------------------------

/// spec: "Plans should support ACTIVE/INACTIVE/HIDDEN... historical
/// subscriptions must not break if a plan is hidden later." A plan is never
/// deleted — HIDDEN removes it from the comparison page for new subscribers
/// while every existing Subscription/SubscriptionPeriod FK pointing at it
/// keeps resolving exactly as before.
enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
  HIDDEN
}

enum SubscriptionPlanPriceStatus {
  ACTIVE
  INACTIVE
}

/// spec: "Potential billing intervals: MONTHLY, ANNUAL. Do not introduce
/// arbitrary complex intervals unless required." Exactly the two the spec
/// names — nothing else.
enum SubscriptionBillingInterval {
  MONTHLY
  ANNUAL
}

/// spec: "Support at least: BOOLEAN, LIMIT." QUOTA is deliberately not
/// added — nothing in H16's actual scope (pet count, household member
/// count, a couple of boolean feature flags) needs a reset-on-a-schedule
/// quota, and the spec itself warns "do not invent usage limits solely to
/// make the system look complex."
enum SubscriptionEntitlementType {
  BOOLEAN
  LIMIT
}

/// The subscription state machine (spec: "use an explicit state machine...
/// do NOT use payment status names as subscription states"). Every status
/// here is a genuine access/lifecycle state, never a payment outcome.
/// Allowed transitions are enforced in code by SubscriptionService (a single
/// `ALLOWED_TRANSITIONS` table, mirroring ArticleLifecycleStatus's own
/// precedent from Handoff 15) — see its own doc comment for the exact graph.
/// PAST_DUE and GRACE_PERIOD are deliberately two distinct steps rather than
/// one combined state (spec explicitly offers both as an option and names
/// GRACE_PERIOD as its own header section): PAST_DUE is "first renewal
/// failure, short retry window, full access"; GRACE_PERIOD is "retry window
/// elapsed, final configurable warning window, full access still" — both
/// keep full entitlements (spec: "do not revoke access immediately"), the
/// distinction exists purely so the UI can escalate urgency honestly.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCEL_AT_PERIOD_END
  CANCELLED
  EXPIRED
}

enum SubscriptionPeriodStatus {
  ACTIVE
  ENDED
}

/// Every meaningful thing that can happen to a Subscription, for admin
/// inspection and the consumer's own billing-history narrative — deliberately
/// separate from AdminAuditLog (which is "what did an admin do", scoped to
/// admin-initiated mutations only) since most of these are consumer- or
/// system-initiated (a household starting a trial, a renewal succeeding, a
/// grace period expiring) and never touch an admin at all.
enum SubscriptionChangeType {
  TRIAL_STARTED
  INITIAL_PURCHASE
  UPGRADE
  DOWNGRADE_SCHEDULED
  DOWNGRADE_APPLIED
  CANCEL_SCHEDULED
  CANCEL_REVERSED
  RENEWED
  PAST_DUE
  GRACE_STARTED
  EXPIRED
  ADMIN_CANCELLED
  ENTITLEMENT_OVERRIDE_GRANTED
  ENTITLEMENT_OVERRIDE_REVOKED
}

/// Why a SubscriptionBillingAttempt was made — never inferred from context,
/// always recorded explicitly (spec: "Track each attempt explicitly").
enum SubscriptionBillingReason {
  INITIAL
  RENEWAL
  UPGRADE
}

enum SubscriptionBillingAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Product packaging (spec: "a plan should represent product packaging...
/// exact names should be configurable and not hardwired deeply into
/// business logic" — `code` is a plain string precisely so no enum ties
/// business logic to "PREMIUM" by name; every entitlement/limit check reads
/// SubscriptionPlanEntitlement rows, never `plan.code`). Display copy is
/// plain fa/en sibling columns rather than Handoff 15's CMS-style
/// `*Locale` child-table pattern — deliberately simpler, since a plan
/// catalog is a handful of admin-managed rows with no versioning/workflow
/// need, unlike a growing article library.
model SubscriptionPlan {
  id            String                 @id @default(uuid()) @db.Uuid
  code          String                 @unique
  nameFa        String
  nameEn        String
  descriptionFa String?
  descriptionEn String?
  status        SubscriptionPlanStatus @default(ACTIVE)
  sortOrder     Int                    @default(0)
  /// Exactly one plan should carry this — the deterministic system default
  /// every household resolves against before ever subscribing (spec:
  /// "Prefer a real FREE plan if it simplifies consistent resolution").
  /// Enforced by SubscriptionPlanService, not a DB constraint (a boolean
  /// uniqueness constraint needs a partial index Prisma's DSL can't express
  /// cleanly for a single nullable-marker column; the service layer is the
  /// simpler, sufficient guard here since plans are admin-managed, not a
  /// high-write table).
  isFree        Boolean                @default(false)
  /// Trial length in days if this plan offers one; null means no trial.
  trialDays     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices                  SubscriptionPlanPrice[]
  entitlements            SubscriptionPlanEntitlement[]
  countryAvailability     SubscriptionPlanCountry[]
  subscriptions           Subscription[]                @relation("CurrentPlan")
  pendingForSubscriptions Subscription[]                @relation("PendingPlan")
  periods                 SubscriptionPeriod[]
  trials                  SubscriptionTrial[]
  changesFrom             SubscriptionChange[]          @relation("ChangeFromPlan")
  changesTo               SubscriptionChange[]          @relation("ChangeToPlan")

  @@map("subscription_plans")
}

/// Country availability is a simple allow-list per plan (spec: "reuse
/// CountryConfig... plan availability should support country-specific
/// behavior... do not fork business logic for Iran directly"). This project
/// has exactly one real country (IR, see common/country/country-config.ts)
/// so today every plan is seeded with a single IR row, but resolution never
/// special-cases "IR" in code — it queries this table.
model SubscriptionPlanCountry {
  id          String           @id @default(uuid()) @db.Uuid
  planId      String           @db.Uuid
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  countryCode String

  createdAt DateTime @default(now())

  @@unique([planId, countryCode])
  @@map("subscription_plan_countries")
}

/// Pricing is deliberately separate from plan identity (spec: "pricing must
/// be separate from plan identity"). `amount` is always integer IRR — the
/// sole financial source of truth (spec: "For Iran, IRR is source of truth.
/// UI may render Toman using the existing currency helper. Do not store
/// Toman as financial truth."); Toman is a ÷10 display transform applied by
/// the frontend's existing `formatCurrency()` helper, exactly as every
/// other financial amount in this codebase already does.
///
/// Prices are append-only history, never edited in place: changing a
/// price creates a new ACTIVE row and flips the old one to INACTIVE with
/// `effectiveTo` set, so a Subscription/SubscriptionPeriod/
/// SubscriptionBillingAttempt created under the old price keeps resolving
/// its own real historical amount forever. Prisma's DSL cannot express "at
/// most one ACTIVE row per (planId, countryCode, billingInterval)" as a
/// `@@unique` (that needs a partial index with a WHERE clause) — the
/// migration hand-appends
/// `CREATE UNIQUE INDEX ... WHERE status = 'ACTIVE'`, the same "documented
/// exception, raw SQL in the migration only" precedent Handoff 01's
/// contact-info CHECK and Handoff 14's approver-not-initiator CHECK already
/// established.
model SubscriptionPlanPrice {
  id              String                      @id @default(uuid()) @db.Uuid
  planId          String                      @db.Uuid
  plan            SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  countryCode     String
  currency        String                      @default("IRR")
  billingInterval SubscriptionBillingInterval
  amount          Int
  status          SubscriptionPlanPriceStatus @default(ACTIVE)
  effectiveFrom   DateTime                    @default(now())
  effectiveTo     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions           Subscription[]               @relation("CurrentPrice")
  pendingForSubscriptions Subscription[]               @relation("PendingPrice")
  periods                 SubscriptionPeriod[]
  billingAttempts         SubscriptionBillingAttempt[]

  @@index([planId, countryCode, billingInterval, status])
  @@map("subscription_plan_prices")
}

/// One row per (plan, entitlement key) — the reusable entitlement
/// definition every feature checks against (spec: "features should not
/// check `if plan == PREMIUM`... instead check entitlements... create a
/// reusable entitlement resolution service"). `key` is a plain string
/// vocabulary (e.g. "pets.max", "household.members.max", "premium.support",
/// "premium.badge"), never a Postgres enum — new entitlement keys are a
/// product/config change, not a schema migration, exactly like
/// AdminPermission's own "TypeScript union, not a DB enum" precedent for a
/// vocabulary expected to grow. `limitValue: null` on a LIMIT-type row is a
/// deliberate, explicit "unlimited" — never confused with "0" or "not
/// configured" (SubscriptionPlanService rejects a LIMIT row with neither
/// value set).
model SubscriptionPlanEntitlement {
  id         String                      @id @default(uuid()) @db.Uuid
  planId     String                      @db.Uuid
  plan       SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  key        String
  type       SubscriptionEntitlementType
  boolValue  Boolean?
  limitValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
  @@map("subscription_plan_entitlements")
}

/// One row per household, ever (spec: "one active/current subscription per
/// household" as a DB constraint) — `householdId @unique` makes this
/// trivially true at the schema level, so a household's subscription
/// lifecycle (FREE forever, or trial → paid → cancelled → resubscribed) is
/// one evolving row, never a new row per state change; history lives in
/// SubscriptionChange/SubscriptionPeriod/SubscriptionBillingAttempt instead
/// — the same "one row that evolves, history captured separately" shape
/// `SellerLedgerAccount` (Handoff 14) already established.
///
/// Every household gets a real row (spec: "prefer a real FREE plan if it
/// simplifies consistent resolution") — created lazily, idempotently, by
/// EntitlementService/SubscriptionService the first time anything asks
/// about a household's subscription, defaulted to the FREE plan with
/// `status: ACTIVE` and `priceId: null`. There is deliberately no "no row
/// exists → improvise fallback entitlements" code path anywhere.
///
/// Paid entitlements remain resolvable through PAST_DUE, GRACE_PERIOD, and
/// CANCEL_AT_PERIOD_END (spec: "do not revoke access immediately") — only
/// CANCELLED/EXPIRED fall back to the FREE plan's own entitlements
/// (EntitlementService's own doc comment has the exact rule).
model Subscription {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @unique @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  planId  String                 @db.Uuid
  plan    SubscriptionPlan       @relation("CurrentPlan", fields: [planId], references: [id], onDelete: Restrict)
  /// Null while on the FREE plan (no price exists for it).
  priceId String?                @db.Uuid
  price   SubscriptionPlanPrice? @relation("CurrentPrice", fields: [priceId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodId String?             @unique @db.Uuid
  currentPeriod   SubscriptionPeriod? @relation("CurrentPeriod", fields: [currentPeriodId], references: [id], onDelete: SetNull)

  /// A scheduled downgrade's target — set by `scheduleDowngrade()`, applied
  /// at the next period boundary by the renewal worker, then cleared (spec:
  /// "downgrade scheduled for next billing period... do not unexpectedly
  /// reduce paid entitlement mid-period").
  pendingPlanId  String?                @db.Uuid
  pendingPlan    SubscriptionPlan?      @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  pendingPriceId String?                @db.Uuid
  pendingPrice   SubscriptionPlanPrice? @relation("PendingPrice", fields: [pendingPriceId], references: [id], onDelete: SetNull)

  trialEndsAt       DateTime?
  gracePeriodEndsAt DateTime?
  cancelRequestedAt DateTime?
  /// Snapshotted at cancel-request time from the current period's own
  /// `endAt` — stable even though `status: CANCEL_AT_PERIOD_END` means no
  /// further renewal will ever move the period boundary again.
  cancelEffectiveAt DateTime?
  expiredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods         SubscriptionPeriod[]         @relation("SubscriptionPeriods")
  changes         SubscriptionChange[]
  billingAttempts SubscriptionBillingAttempt[]
  trials          SubscriptionTrial[]

  @@map("subscriptions")
}

/// One billing cycle. `status: ENDED` is set the moment a period is
/// superseded (a renewal creates the next ACTIVE period and ends this one)
/// or the subscription reaches CANCELLED/EXPIRED — never deleted, so
/// billing history always has a complete period ledger to render (spec:
/// "user should see: plan, period, amount, billing status").
model SubscriptionPeriod {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation("SubscriptionPeriods", fields: [subscriptionId], references: [id], onDelete: Cascade)

  planId  String                 @db.Uuid
  plan    SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceId String?                @db.Uuid
  price   SubscriptionPlanPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict)

  status  SubscriptionPeriodStatus @default(ACTIVE)
  startAt DateTime
  endAt   DateTime
  isTrial Boolean                  @default(false)

  createdAt DateTime @default(now())

  currentForSubscription Subscription?                @relation("CurrentPeriod")
  billingAttempts        SubscriptionBillingAttempt[]

  @@index([subscriptionId, status])
  @@map("subscription_periods")
}

/// One row per attempted charge — initial purchase, renewal, or upgrade
/// (spec: "track each attempt explicitly... do not overwrite failed
/// attempts"). `attemptNumber` is computed the same race-safe way
/// Handoff 15's `ContentVersion.versionNumber` is: a row-lock on the last
/// attempt for this subscription inside the same transaction, then
/// `count + 1` — never a global sequence, since it only needs to order one
/// subscription's own attempt history. `idempotencyKey` is the caller- or
/// worker-supplied key that makes a duplicate renewal-worker tick or a
/// replayed `POST /subscribe` converge on the same attempt row instead of
/// creating a second PaymentIntent.
model SubscriptionBillingAttempt {
  id             String                 @id @default(uuid()) @db.Uuid
  subscriptionId String                 @db.Uuid
  subscription   Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Null until the attempt succeeds and a period is actually created
  /// (an initial-purchase attempt has no period yet when the attempt row
  /// is first created).
  periodId       String?                @db.Uuid
  period         SubscriptionPeriod?    @relation(fields: [periodId], references: [id], onDelete: SetNull)
  priceId        String?                @db.Uuid
  price          SubscriptionPlanPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)

  reason        SubscriptionBillingReason
  attemptNumber Int

  paymentIntentId String?        @db.Uuid
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  idempotencyKey String? @unique

  status        SubscriptionBillingAttemptStatus @default(PENDING)
  failureCode   String?
  failureReason String?

  amount   Int
  currency String @default("IRR")

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([subscriptionId, createdAt])
  @@map("subscription_billing_attempts")
}

/// The append-only "what happened to this subscription" narrative — see the
/// `SubscriptionChangeType` doc comment for why this is distinct from
/// AdminAuditLog. Exactly one of `initiatedByUserId`/`initiatedByAdminId` is
/// set for a human-initiated change; both are null for a system-initiated
/// one (a renewal-worker-driven PAST_DUE/EXPIRED transition).
model SubscriptionChange {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type       SubscriptionChangeType
  fromPlanId String?                @db.Uuid
  fromPlan   SubscriptionPlan?      @relation("ChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlanId   String?                @db.Uuid
  toPlan     SubscriptionPlan?      @relation("ChangeToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)

  effectiveAt DateTime?
  note        String?

  initiatedByUserId  String?    @db.Uuid
  initiatedByAdminId String?    @db.Uuid
  initiatedByAdmin   AdminUser? @relation(fields: [initiatedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_changes")
}

/// Eligibility + record in one row (spec: "trial start/end... eligibility
/// checked server-side... one trial per household per relevant plan family
/// unless configured otherwise... no repeated trial abuse"). `@@unique on
/// (householdId, planId)` is the actual anti-abuse enforcement — a second
/// `POST /subscription/trial` for the same household+plan is rejected by
/// the database itself, not just an application-layer check that a retried
/// request could race past.
model SubscriptionTrial {
  id             String           @id @default(uuid()) @db.Uuid
  householdId    String           @db.Uuid
  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  subscriptionId String           @db.Uuid
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String           @db.Uuid
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  startAt DateTime @default(now())
  endAt   DateTime

  createdAt DateTime @default(now())

  @@unique([householdId, planId])
  @@map("subscription_trials")
}

/// A support/admin escape hatch, never a silent plan edit (spec: "never
/// silently modify plan definitions for one customer... require audit and
/// expiry"). `active` is an explicit admin-revoke flag distinct from
/// natural `expiresAt` elapsing — both are checked by EntitlementService.
/// Every grant/revoke is also recorded as a SubscriptionChange and an
/// AdminAuditLog entry.
model SubscriptionEntitlementOverride {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  key        String
  type       SubscriptionEntitlementType
  boolValue  Boolean?
  limitValue Int?

  reason           String
  createdByAdminId String    @db.Uuid
  createdByAdmin   AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  expiresAt DateTime?
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId, key])
  @@map("subscription_entitlement_overrides")
}

// ---------------------------------------------------------------------------
// Advanced Health / Clinical OS (Handoff 17)
//
// Extends the Health & Care foundation (Handoff 02) into a longitudinal
// clinical system. Every new model here follows the same FK policy as the
// Handoff 02 block: onDelete: Restrict back to Pet — clinical history must
// never be silently destroyed by a Pet row disappearing. Provider-authored
// content uses a real FK to ProviderUser (not a plain audit-only UUID)
// because, unlike Booking.completedByProviderUserId, the author's identity
// IS the clinical content ("Dr. X performed this visit") — the same
// precedent already set by BookingProviderNote.providerUserId.
//
// The longitudinal Health Timeline is deliberately NOT a stored table —
// HealthTimelineService reads and merges the models below (plus the
// existing H02 models) at query time, the same "derived, never duplicated"
// approach H16's UsageService uses for metering. This avoids a second copy
// of data that could drift from the source-of-truth rows.
//
// Provider originals are never edited or hard-deleted in place. Three
// distinct mechanisms enforce this, chosen per record shape:
//   - MedicalDocument / ImagingStudy: void (voidedAt/voidedReason) + append a new one.
//   - LabResult: supersede (supersedesId self-relation) — a corrected result
//     is a new row pointing back at the one it replaces.
//   - ClinicalVisit: revision history (ClinicalVisitRevision) — a completed
//     visit's amendment snapshots the prior content before overwriting it.
// Owner disagreement with any provider-sourced record never edits that
// record — it creates a MedicalRecordCorrection alongside it instead.
// ---------------------------------------------------------------------------

enum MedicalDocumentType {
  LAB_REPORT
  IMAGING_REPORT
  PRESCRIPTION
  VACCINATION_CERTIFICATE
  REFERRAL
  DISCHARGE_SUMMARY
  CLINICAL_NOTE
  DENTAL_RECORD
  NUTRITION_PLAN
  REHAB_PLAN
  OTHER
}

/// HOUSEHOLD_ONLY is the safe default (spec: "private medical documents must
/// never be publicly exposed") — a document is reachable by a provider only
/// when BOTH this is PROVIDER_SHARED AND that provider currently holds an
/// active PetAccessGrant with canViewHealth for this pet. Setting this to
/// PROVIDER_SHARED never bypasses PetAccessGrant on its own.
enum DocumentVisibility {
  HOUSEHOLD_ONLY
  PROVIDER_SHARED
}

/// PROVIDER-sourced documents are marked PROVIDER_VERIFIED automatically —
/// the provider organization stands behind its own record. OWNER-uploaded
/// documents start UNVERIFIED. This is a factual provenance label, never a
/// judgment about whether the document is genuine.
enum DocumentVerificationStatus {
  UNVERIFIED
  PROVIDER_VERIFIED
}

/// Which existing record types an owner correction can attach to — mirrors
/// AdminAuditLog's entityType/entityId polymorphic-reference pattern (plain
/// string id, no FK, since one table cannot hold a real FK to several
/// different target tables).
enum CorrectableRecordType {
  CONDITION
  ALLERGY
  MEDICATION
  VACCINATION_SUMMARY
  LAB_RESULT
  IMAGING_STUDY
  MEDICAL_DOCUMENT
  CLINICAL_VISIT
}

enum MedicalRecordCorrectionStatus {
  OPEN
  ACKNOWLEDGED_BY_PROVIDER
  RESOLVED
}

/// PENDING = ordered but not yet resulted. FINAL = the result of record.
/// AMENDED/CANCELLED never overwrite a FINAL row in place — a correction is
/// always a new row pointing back via supersedesId.
enum LabResultStatus {
  PENDING
  FINAL
  AMENDED
  CANCELLED
}

/// Deliberately nullable and NEVER inferred by comparing value/unit against
/// referenceRange in application code (spec: "do not invent medical
/// interpretation") — only ever set by an explicit provider designation.
enum LabResultFlag {
  NORMAL
  ABNORMAL
}

enum ImagingStudyType {
  XRAY
  ULTRASOUND
  CT
  MRI
  OTHER
}

enum ReferralStatus {
  CREATED
  SENT
  ACCEPTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DentalRecordType {
  EXAM
  CLEANING
  PROCEDURE
  EXTRACTION
  FINDING
  FOLLOW_UP
}

enum RehabPlanStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum ObservationCategory {
  SYMPTOM
  APPETITE
  BEHAVIOR
  MOBILITY
  STOOL
  VOMITING
  SLEEP
  PAIN
  OTHER
}

enum ObservationMediaType {
  PHOTO
  VIDEO
}

/// Booking = commercial/scheduling state. ClinicalVisit = care-documentation
/// state — the two are deliberately never collapsed into one model (spec:
/// "Do not collapse Booking into Clinical Visit"). AMENDED means "was
/// COMPLETED, then edited" — the prior content is preserved as a
/// ClinicalVisitRevision row, never overwritten in place without a trace.
/// VOIDED is terminal.
enum ClinicalVisitStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  AMENDED
  VOIDED
}

enum CarePlanItemType {
  MEDICATION
  FOLLOW_UP
  NUTRITION
  REHAB
  MONITORING
  REFERRAL
  VACCINATION
  OTHER
}

enum CarePlanItemStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CarePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model MedicalDocument {
  id          String    @id @default(uuid()) @db.Uuid
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  documentType MedicalDocumentType
  title        String
  description  String?

  sourceType                   SourceType
  /// Plain UUID, no FK — same audit-reference pattern as
  /// Allergy.recordedByUserId. Set when sourceType is OWNER/HOUSEHOLD_MEMBER.
  sourceUserId                 String?               @db.Uuid
  sourceProviderOrganizationId String?               @db.Uuid
  sourceProviderOrganization   ProviderOrganization? @relation(fields: [sourceProviderOrganizationId], references: [id], onDelete: Restrict)
  sourceProviderUserId         String?               @db.Uuid
  sourceProviderUser           ProviderUser?         @relation(fields: [sourceProviderUserId], references: [id], onDelete: Restrict)

  /// The clinically-relevant date (e.g. when a lab sample was taken) — may
  /// differ from uploadedAt. Nullable: not every document type has one.
  recordedAt DateTime?
  uploadedAt DateTime  @default(now())

  /// Private object storage key — never a public URL (spec: "do not store
  /// public object URLs"). Reads always go through a short-TTL signed
  /// download URL minted per-request after authorization — see
  /// HealthStorageService.
  fileObjectKey String  @unique
  mimeType      String
  fileSizeBytes Int
  checksum      String?

  visibility         DocumentVisibility         @default(HOUSEHOLD_ONLY)
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)

  relatedVisitId        String?        @db.Uuid
  relatedVisit          ClinicalVisit? @relation(fields: [relatedVisitId], references: [id], onDelete: SetNull)
  relatedLabResultId    String?        @db.Uuid
  relatedLabResult      LabResult?     @relation(fields: [relatedLabResultId], references: [id], onDelete: SetNull)
  relatedImagingStudyId String?        @db.Uuid
  relatedImagingStudy   ImagingStudy?  @relation(fields: [relatedImagingStudyId], references: [id], onDelete: SetNull)
  relatedReferralId     String?        @db.Uuid
  relatedReferral       Referral?      @relation(fields: [relatedReferralId], references: [id], onDelete: SetNull)

  /// Provider-sourced documents are never hard-deleted or replaced in place —
  /// see the locked principle "provider-originated clinical records must not
  /// be silently overwritten". Voiding is the only way to retract one; the
  /// replacement is a new MedicalDocument row.
  voidedAt     DateTime?
  voidedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@index([householdId])
  @@index([documentType])
  @@map("medical_documents")
}

model MedicalRecordCorrection {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  /// Polymorphic reference to the original record being corrected — plain
  /// string id, no FK (see the doc comment on CorrectableRecordType). The
  /// original record is NEVER edited or deleted by a correction — see the
  /// locked principle "owner corrections must preserve history".
  targetType CorrectableRecordType
  targetId   String                @db.Uuid

  correctionText  String
  createdByUserId String                        @db.Uuid
  status          MedicalRecordCorrectionStatus @default(OPEN)

  resolvedAt   DateTime?
  resolvedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([petId])
  @@map("medical_record_corrections")
}

model LabResult {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId   String?               @db.Uuid
  providerOrganization     ProviderOrganization? @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  recordedByProviderUserId String?               @db.Uuid
  recordedByProviderUser   ProviderUser?         @relation(fields: [recordedByProviderUserId], references: [id], onDelete: Restrict)
  clinicalVisitId          String?               @db.Uuid
  clinicalVisit            ClinicalVisit?        @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)

  testName String
  testCode String?

  sampleDate DateTime? @db.Date
  resultDate DateTime? @db.Date

  value              String?
  unit               String?
  referenceRangeLow  Decimal? @db.Decimal(10, 3)
  referenceRangeHigh Decimal? @db.Decimal(10, 3)
  qualitativeResult  String?

  status LabResultStatus @default(PENDING)
  /// Never derived by application code — see the doc comment on LabResultFlag.
  flag   LabResultFlag?

  sourceType SourceType @default(PROVIDER)
  notes      String?

  /// Append/supersede semantics for a correction, per the section-level doc
  /// comment — the superseded row's status is set to AMENDED, never deleted.
  supersedesId String?    @unique @db.Uuid
  supersedes   LabResult? @relation("LabResultSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy LabResult? @relation("LabResultSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents MedicalDocument[]

  @@index([petId])
  @@index([status])
  @@map("lab_results")
}

model ImagingStudy {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId    String?               @db.Uuid
  providerOrganization      ProviderOrganization? @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  performedByProviderUserId String?               @db.Uuid
  performedByProviderUser   ProviderUser?         @relation(fields: [performedByProviderUserId], references: [id], onDelete: Restrict)
  clinicalVisitId           String?               @db.Uuid
  clinicalVisit             ClinicalVisit?        @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)

  studyType   ImagingStudyType
  bodyRegion  String?
  performedAt DateTime?

  /// Free-text provider report — never an automated diagnosis (spec: "do not
  /// attempt image diagnosis").
  report         String?
  findings       String?
  recommendation String?

  sourceType SourceType @default(PROVIDER)

  voidedAt     DateTime?
  voidedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents MedicalDocument[]

  @@index([petId])
  @@map("imaging_studies")
}

/// Deliberately separate from Booking state (spec: "Keep Referral state
/// separate from Booking state") — fulfillingBookingId only records which
/// booking (if any) fulfilled the referral; it never drives `status`.
model Referral {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  fromProviderOrganizationId String               @db.Uuid
  fromProviderOrganization   ProviderOrganization @relation("ReferralFrom", fields: [fromProviderOrganizationId], references: [id], onDelete: Restrict)
  fromProviderUserId         String?              @db.Uuid
  fromProviderUser           ProviderUser?        @relation(fields: [fromProviderUserId], references: [id], onDelete: Restrict)

  /// Set when the destination exists in PET LIFE OS; otherwise the external
  /// fields below carry the destination (spec: "if not, support external
  /// referral metadata").
  toProviderOrganizationId String?               @db.Uuid
  toProviderOrganization   ProviderOrganization? @relation("ReferralTo", fields: [toProviderOrganizationId], references: [id], onDelete: Restrict)
  externalProviderName     String?
  externalSpecialty        String?

  reason String
  notes  String?
  status ReferralStatus @default(CREATED)

  clinicalVisitId     String?        @db.Uuid
  clinicalVisit       ClinicalVisit? @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)
  fulfillingBookingId String?        @db.Uuid
  fulfillingBooking   Booking?       @relation(fields: [fulfillingBookingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  documents MedicalDocument[]

  @@index([petId])
  @@index([status])
  @@map("referrals")
}

model DentalRecord {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId String?               @db.Uuid
  providerOrganization   ProviderOrganization? @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerUserId         String?               @db.Uuid
  providerUser           ProviderUser?         @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  clinicalVisitId        String?               @db.Uuid
  clinicalVisit          ClinicalVisit?        @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)

  recordType          DentalRecordType
  performedAt         DateTime?
  findings            String?
  notes               String?
  followUpRecommended Boolean          @default(false)
  followUpNotes       String?

  sourceType SourceType @default(PROVIDER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@map("dental_records")
}

/// Provider-issued structured plan — distinct from the owner's free-text
/// NutritionProfile (Handoff 02), which stays untouched. Spec: "do not
/// silently treat commerce product recommendations as clinical
/// prescriptions" — recommendedFoodText is free text the provider writes,
/// never auto-populated from the Shop catalog.
model ClinicalNutritionPlan {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  clinicalVisitId        String?              @db.Uuid
  clinicalVisit          ClinicalVisit?       @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)

  goal                String?
  dietType            DietType?
  recommendedFoodText String?
  dailyAmountText     String?
  frequencyText       String?
  restrictionsText    String?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  status CarePlanItemStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@map("clinical_nutrition_plans")
}

model RehabPlan {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  clinicalVisitId        String?              @db.Uuid
  clinicalVisit          ClinicalVisit?       @relation(fields: [clinicalVisitId], references: [id], onDelete: SetNull)

  goal          String?
  exercisesText String?
  frequencyText String?
  durationText  String?

  status RehabPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions RehabSession[]

  @@index([petId])
  @@map("rehab_plans")
}

model RehabSession {
  id          String    @id @default(uuid()) @db.Uuid
  rehabPlanId String    @db.Uuid
  rehabPlan   RehabPlan @relation(fields: [rehabPlanId], references: [id], onDelete: Restrict)

  sessionDate   DateTime @db.Date
  observation   String?
  progressNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rehabPlanId])
  @@map("rehab_sessions")
}

/// Owner-recorded, never a diagnosis (spec: "these are OWNER OBSERVATIONS,
/// not diagnoses"). `category` is a coarse label the owner chooses, not a
/// clinical classification. Photo/video reuse the same private storage path
/// as MedicalDocument (HealthStorageService) — never auto-converted into a
/// medical finding.
model PetObservation {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  category    ObservationCategory
  description String
  observedAt  DateTime

  mediaType      ObservationMediaType?
  mediaObjectKey String?
  mediaMimeType  String?

  sourceType       SourceType @default(OWNER)
  recordedByUserId String     @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@index([category])
  @@map("pet_observations")
}

model ClinicalVisit {
  id          String    @id @default(uuid()) @db.Uuid
  petId       String    @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerUserId         String               @db.Uuid
  providerUser           ProviderUser         @relation(fields: [providerUserId], references: [id], onDelete: Restrict)

  reasonForVisit   String?
  /// Structured note sections (spec: "preserve structured separation"
  /// without forcing SOAP naming) — historyText/observationsText/
  /// assessmentText/planText map to Subjective/Objective/Assessment/Plan.
  historyText      String?
  observationsText String?
  assessmentText   String?
  planText         String?

  status      ClinicalVisitStatus @default(DRAFT)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions      ClinicalVisitRevision[]
  labResults     LabResult[]
  imagingStudies ImagingStudy[]
  referrals      Referral[]
  dentalRecords  DentalRecord[]
  nutritionPlans ClinicalNutritionPlan[]
  rehabPlans     RehabPlan[]
  carePlans      CarePlan[]
  documents      MedicalDocument[]
  medications    Medication[]

  @@index([petId])
  @@index([householdId])
  @@index([providerOrganizationId])
  @@index([status])
  @@map("clinical_visits")
}

/// Append-only amendment history — a COMPLETED visit is never silently
/// edited in place. Before applying an amendment, ClinicalVisitService
/// snapshots the visit's current note fields + status into a new row here,
/// then updates the live ClinicalVisit row and sets its status to AMENDED.
model ClinicalVisitRevision {
  id              String        @id @default(uuid()) @db.Uuid
  clinicalVisitId String        @db.Uuid
  clinicalVisit   ClinicalVisit @relation(fields: [clinicalVisitId], references: [id], onDelete: Restrict)

  revisionNumber Int

  /// Snapshot of the visit's note fields + status immediately BEFORE this
  /// amendment was applied.
  snapshotStatus           ClinicalVisitStatus
  snapshotReasonForVisit   String?
  snapshotHistoryText      String?
  snapshotObservationsText String?
  snapshotAssessmentText   String?
  snapshotPlanText         String?

  /// Plain UUID, no FK — same audit-reference pattern as
  /// Booking.completedByProviderUserId; deleting a ProviderUser later must
  /// never alter clinical audit history.
  amendedByProviderUserId String @db.Uuid
  reason                  String

  createdAt DateTime @default(now())

  @@unique([clinicalVisitId, revisionNumber])
  @@map("clinical_visit_revisions")
}

model CarePlan {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  providerOrganizationId String               @db.Uuid
  providerOrganization   ProviderOrganization @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  providerUserId         String?              @db.Uuid
  providerUser           ProviderUser?        @relation(fields: [providerUserId], references: [id], onDelete: Restrict)
  originatingVisitId     String?              @db.Uuid
  originatingVisit       ClinicalVisit?       @relation(fields: [originatingVisitId], references: [id], onDelete: SetNull)

  title  String
  status CarePlanStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CarePlanItem[]

  @@index([petId])
  @@map("care_plans")
}

model CarePlanItem {
  id         String   @id @default(uuid()) @db.Uuid
  carePlanId String   @db.Uuid
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Restrict)

  type   CarePlanItemType
  title  String
  detail String?

  status CarePlanItemStatus @default(PENDING)
  source SourceType         @default(PROVIDER)
  dueAt  DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medications Medication[]

  @@index([carePlanId])
  @@index([status])
  @@map("care_plan_items")
}

/// Foundation only — no scoring engine (spec: "do not introduce scoring
/// unless clinically justified"). Free-text, append-only observations,
/// authorable by either the owner or a provider.
model SeniorCareNote {
  id    String @id @default(uuid()) @db.Uuid
  petId String @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  mobilityNotes             String?
  cognitionNotes            String?
  medicationComplexityNotes String?
  monitoringFrequencyText   String?
  qualityOfLifeNotes        String?

  sourceType             SourceType            @default(OWNER)
  recordedByUserId       String?               @db.Uuid
  providerOrganizationId String?               @db.Uuid
  providerOrganization   ProviderOrganization? @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@map("senior_care_notes")
}

/// Careful, non-commercial foundation (spec: "End-of-Life / Aftercare
/// Foundation"). Creating or updating this record never changes
/// Pet.lifecycleStatus — pet lifecycle transitions remain an explicit,
/// separate action (spec: "Do not trigger memorial lifecycle automatically").
/// One row per pet: successive edits update it in place (these are private
/// planning notes, not append-only clinical truth), so no revision history
/// is kept — unlike ClinicalVisit/LabResult/ImagingStudy.
model EndOfLifeCarePlan {
  id    String @id @default(uuid()) @db.Uuid
  petId String @unique @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  palliativeCareNotes  String?
  endOfLifePreferences String?
  aftercarePreferences String?

  sourceType             SourceType            @default(OWNER)
  recordedByUserId       String?               @db.Uuid
  providerOrganizationId String?               @db.Uuid
  providerOrganization   ProviderOrganization? @relation(fields: [providerOrganizationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("end_of_life_care_plans")
}
