NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://petlife:petlife@localhost:5432/petlife_os?schema=public"

REDIS_URL="redis://localhost:6379"

# Comma-separated list of allowed browser origins for CORS + cookie issuance.
WEB_APP_ORIGIN="http://localhost:3000"

# HMAC secret for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-change-me-dev-only-change-me"
SESSION_COOKIE_NAME="petlife_session"
SESSION_TTL_DAYS=30

# CSRF double-submit cookie secret.
CSRF_SECRET="dev-only-change-me-csrf-dev-only"

# OTP behaviour (dev provider prints codes to the server log instead of sending SMS/email).
OTP_PROVIDER="dev"
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Object storage (S3-compatible). Local dev defaults point at the docker-compose MinIO service.
STORAGE_DRIVER="local"
STORAGE_S3_ENDPOINT="http://localhost:9000"
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_BUCKET="petlife-dev"
STORAGE_S3_ACCESS_KEY_ID="petlife"
STORAGE_S3_SECRET_ACCESS_KEY="petlife123"
STORAGE_LOCAL_DIR="./local-storage"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"

# Vet booking (Handoff 03)
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_HEALTH_ACCESS_BUFFER_HOURS=24

# Real Payments + BNPL (Handoff 07) — see README "Sandbox / production".
# No real merchant credentials exist for this project; every provider below
# is a documented sandbox stub. Never set PAYMENT_SANDBOX_MODE=production
# without real credentials — startup will refuse to boot if you do.
PAYMENT_SANDBOX_MODE="sandbox"
STANDARD_GATEWAY_ENABLED=true
SNAPPAY_ENABLED=true
DIGIPAY_ENABLED=true
# STANDARD_GATEWAY_MERCHANT_ID=
# STANDARD_GATEWAY_API_KEY=
# SNAPPAY_MERCHANT_ID=
# SNAPPAY_API_KEY=
# DIGIPAY_MERCHANT_ID=
# DIGIPAY_API_KEY=
