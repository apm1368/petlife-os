NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://petlife:petlife@localhost:5432/petlife_os?schema=public"

REDIS_URL="redis://localhost:6379"

# Comma-separated list of allowed browser origins for CORS + cookie issuance.
WEB_APP_ORIGIN="http://localhost:3000"

# HMAC secret for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-change-me-dev-only-change-me"
SESSION_COOKIE_NAME="petlife_session"
SESSION_TTL_DAYS=30

# CSRF double-submit cookie secret.
CSRF_SECRET="dev-only-change-me-csrf-dev-only"

# OTP behaviour (dev provider prints codes to the server log instead of sending SMS/email).
OTP_PROVIDER="dev"
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Google OAuth sign-in. Disabled by default — the app works fully without it
# (OTP and username/password remain available). To enable, create an OAuth
# client at https://console.cloud.google.com/apis/credentials and set the
# callback URL to <API base URL>/auth/google/callback.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Username/password auth.
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Object storage (S3-compatible). Local dev defaults point at the docker-compose MinIO service.
STORAGE_DRIVER="local"
STORAGE_S3_ENDPOINT="http://localhost:9000"
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_BUCKET="petlife-dev"
STORAGE_S3_ACCESS_KEY_ID="petlife"
STORAGE_S3_SECRET_ACCESS_KEY="petlife123"
STORAGE_LOCAL_DIR="./local-storage"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/uploads"

# Vet booking (Handoff 03)
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_HEALTH_ACCESS_BUFFER_HOURS=24

# Real Payments + BNPL (Handoff 07) — see README "Sandbox / production".
# No real merchant credentials exist for this project; every provider below
# is a documented sandbox stub. Never set PAYMENT_SANDBOX_MODE=production
# without real credentials — startup will refuse to boot if you do.
PAYMENT_SANDBOX_MODE="sandbox"
STANDARD_GATEWAY_ENABLED=true
SNAPPAY_ENABLED=true
DIGIPAY_ENABLED=true
# STANDARD_GATEWAY_MERCHANT_ID=
# STANDARD_GATEWAY_API_KEY=
# SNAPPAY_MERCHANT_ID=
# SNAPPAY_API_KEY=
# DIGIPAY_MERCHANT_ID=
# DIGIPAY_API_KEY=

# Delivery & Logistics Core (Handoff 08) — see README "Provider integration
# status". No official AloPeyk/SnappBox merchant credentials exist for this
# project; every real provider below is a documented adapter-boundary stub.
# Never set SHIPPING_MODE=production without real credentials — startup will
# refuse to boot if you do.
SHIPPING_MODE="sandbox"
DEV_SHIPPING_ENABLED=true
ALOPEYK_ENABLED=true
SNAPPBOX_ENABLED=true
# ALOPEYK_API_BASE_URL=
# ALOPEYK_API_KEY=
# ALOPEYK_WEBHOOK_SECRET=
# SNAPPBOX_API_BASE_URL=
# SNAPPBOX_API_KEY=
# SNAPPBOX_WEBHOOK_SECRET=

# Seller OS + Marketplace Channel Integrations (Handoff 09) — see README
# "Provider integration status". No official Torob/Digikala merchant
# credentials exist for this project; every real provider below is a
# documented adapter-boundary stub. Never set MARKETPLACE_SANDBOX_MODE=production
# without real credentials — startup will refuse to boot if you do.
MARKETPLACE_SANDBOX_MODE="sandbox"
DEV_MARKETPLACE_ENABLED=true
TOROB_ENABLED=true
DIGIKALA_ENABLED=true
# TOROB_BASE_URL=
# TOROB_API_KEY=
# DIGIKALA_BASE_URL=
# DIGIKALA_API_KEY=

# Messaging, Notifications & Preferences (Handoff 10) — see README
# "Faraz SMS integration status". No official Faraz SMS merchant
# documentation or credentials exist for this project; FARAZ below is a
# documented adapter-boundary stub, same as every provider above. Never set
# MESSAGING_SANDBOX_MODE=production without real credentials — startup will
# refuse to boot if you do.
MESSAGING_PROVIDER="dev"
MESSAGING_SANDBOX_MODE="sandbox"
DEV_MESSAGING_ENABLED=true
FARAZ_SMS_ENABLED=true
# FARAZ_SMS_BASE_URL=
# FARAZ_SMS_API_KEY=
# FARAZ_SMS_SENDER=
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
NOTIFICATION_WORKER_INTERVAL_MS=5000

# Admin CRM + Support + Disputes + Trust Operations (Handoff 11)
ADMIN_REFUND_APPROVAL_THRESHOLD_IRR=5000000

# Marketplace & Seller Financial Settlement (Handoff 14)
DEFAULT_PLATFORM_COMMISSION_BPS=1000
SETTLEMENT_APPROVAL_THRESHOLD_IRR=10000000
