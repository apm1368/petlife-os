{
  "name": "petlife-os",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @petlife/api db:migrate",
    "db:seed": "pnpm --filter @petlife/api db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:e2e:fresh": "pnpm infra:up && pnpm --filter @petlife/api test:e2e:fresh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
